// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================== Enums ====================

enum Assignment {
  VERIFIER
  ADMIN
}

enum Role {
  ADMIN
  MODERATOR
  CAMPAIGN_CREATOR
  DONOR
}

// ==================== User & Auth ====================

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String
  password         String?
  avatar           String?
  phone            String?
  isVerified       Boolean  @default(false)
  verificationType String? // "ktp" | "organization"
  role             Role     @default(DONOR)
  donationBalance  Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  accounts        Account[]
  campaigns       Campaign[]
  volunteerTrips  VolunteerTrip[]
  registrations   Registration[]
  donations       Donation[]
  prayers       Prayer[]
  notifications Notification[]
  autoDonations AutoDonation[]
  assignments   UserAssignment[]
  assignmentAuditsAsSubject AssignmentAuditEntry[] @relation("AssignmentAuditSubject")
  assignmentAuditsAsActor   AssignmentAuditEntry[] @relation("AssignmentAuditActor")
  campaignStatusChanges     CampaignStatusChange[]
  cancellationRequestsMade    CancellationRequest[] @relation("CancellationRequester")
  cancellationRequestsDecided CancellationRequest[] @relation("CancellationDecider")
  campaignFlagsRaised         CampaignFlag[]        @relation("FlagVerifier")
  campaignFlagsResolved       CampaignFlag[]        @relation("FlagResolver")

  // Money layer
  bankAccounts     BankAccount[]
  payoutsRequested Payout[]      @relation("PayoutRequester")
  payoutsApproved  Payout[]      @relation("PayoutApprover")
  refundsRequested Refund[]      @relation("RefundRequester")
  refundsApproved  Refund[]      @relation("RefundApprover")

  @@index([email])
}

/// Verifier and Admin are assignments a person holds, not ranks.
/// One person may hold both; holding both is two rows, never a special
/// case. See ADR 0005. The `Role` hierarchy still governs access until
/// tickets 07-08 migrate the guards; this model only records who holds
/// what in the meantime.
model UserAssignment {
  userId     String
  assignment Assignment
  assignedAt DateTime   @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, assignment])
  @@index([assignment])
}

enum AssignmentAuditAction {
  GRANTED
  REVOKED
}

/// One row per grant or revoke event, kept even after the UserAssignment
/// row itself is deleted on revoke. This is what lets granting, revoking,
/// and regranting the same assignment keep its full history -- a
/// soft-delete on UserAssignment itself would not, since that model's
/// composite primary key assumes one row per currently-held assignment.
model AssignmentAuditEntry {
  id         String                @id @default(cuid())
  userId     String
  assignment Assignment
  action     AssignmentAuditAction
  actedById  String
  actedAt    DateTime              @default(now())

  // Relations
  user    User @relation("AssignmentAuditSubject", fields: [userId], references: [id], onDelete: Cascade)
  actedBy User @relation("AssignmentAuditActor", fields: [actedById], references: [id])

  @@index([userId])
  @@index([assignment])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ==================== Campaign ====================

enum CampaignStatus {
  DRAFT
  SUBMITTED
  REJECTED
  ACTIVE
  SUSPENDED
  CANCELLED
  COMPLETED
  EXPIRED
}

model Campaign {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  description     String    @db.Text
  story           String    @db.Text
  coverImage      String
  targetAmount    Int
  collectedAmount Int       @default(0)
  category        String
  // Legacy status string: no application code or seed reads or writes it
  // (legacy-status-contract 02). Nullable and ignored until ticket 03 drops
  // it with its index.
  status          String?
  lifecycleStatus CampaignStatus @default(SUBMITTED)
  isUrgent        Boolean   @default(false)
  deadline        DateTime?
  creatorId       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  /// Sample/demo content, not a real appeal. Set by a one-time migration for
  /// the 30 campaigns that existed before the money layer (task M9) -- every
  /// one of them had zero Payment rows behind any of their donations, which
  /// is what proves they predate real money rather than a date this schema
  /// would have to keep in sync. NEVER set true by application code: `false`
  /// is the only default, a new campaign never inherits it, and nothing in
  /// this codebase should ever flip it back on. It is enforcement, not just
  /// a label -- POST /api/donations and requestPayout (src/lib/money/
  /// payouts.ts) both refuse a campaign with this flag before writing
  /// anything, and GET /api/admin/reconcile excludes it from its comparison
  /// entirely, because its collectedAmount is fixture data with no ledger
  /// behind it by design.
  ///
  /// DO NOT REUSE THE M9 MIGRATION ON ANOTHER ENVIRONMENT. Its UPDATE is a
  /// one-time, environment-specific statement written for THIS database's
  /// state on 18 September 2026 -- it does not mean "created before task M9
  /// shipped", it means "has no Payment behind any of its donations YET".
  /// Applied anywhere that already holds real, unpaid-so-far campaigns (a
  /// fresh environment stood up as part of the planned dev/stg/prod split,
  /// for instance), it would mark every one of them isDemo and permanently
  /// block their donations. If a future environment needs its own demo data
  /// marked, write that environment a new migration with its own predicate
  /// -- do not point it at this one.
  isDemo          Boolean   @default(false)

  // Relations
  creator       User             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  donations     Donation[]
  updates       CampaignUpdate[]
  // Disbursement is replaced by Payout, which carries status, an approver and
  // a destination account -- see the Money section.
  payouts       Payout[]
  ledgerEntries LedgerEntry[]
  prayers       Prayer[]
  statusChanges CampaignStatusChange[]
  cancellationRequests CancellationRequest[]
  flags                CampaignFlag[]

  @@index([slug])
  @@index([category])
  @@index([status])
  @@index([lifecycleStatus])
  @@index([creatorId])
  @@index([isUrgent, status])
}

enum CampaignStatusChangeAction {
  SUBMISSION_APPROVED
  SUBMISSION_REJECTED
  COMPLETED
  SUSPENDED
  SUSPENSION_LIFTED
  CANCELLED
  EXPIRED
  URGENT_SET
  URGENT_CLEARED
}

/// The capacity a person acted in (ADR 0005). One person may hold several
/// assignments; the record says which one this change was made under.
/// SYSTEM is a change nobody made by hand: lazy expiry, and Urgent dropping
/// because the Campaign left Active.
enum StatusChangeCapacity {
  FUNDRAISER
  VERIFIER
  ADMIN
  SYSTEM
}

/// Append-only record of every Campaign status change and every Urgent
/// change (PRD §9). Written only by src/lib/campaign-lifecycle.ts, in the
/// same transaction as the change itself; never updated or deleted. Lifting
/// a Suspension reads the latest SUSPENDED row for the status to restore
/// (ADR 0015), so this is load-bearing, not just an audit trail.
///
/// onDelete: Restrict on both relations, like Payout: deleting a Campaign
/// or a person must never erase who changed what. A Campaign with history
/// can therefore no longer be hard-deleted, which is the point.
model CampaignStatusChange {
  id         String                     @id @default(cuid())
  campaignId String
  action     CampaignStatusChangeAction
  /// Both null for URGENT_SET / URGENT_CLEARED, which change no status.
  fromStatus CampaignStatus?
  toStatus   CampaignStatus?
  /// Null exactly when capacity is SYSTEM.
  actorId    String?
  capacity   StatusChangeCapacity
  reason     String?
  createdAt  DateTime                   @default(now())

  // Relations
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  actor    User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([campaignId, createdAt])
}

/// PENDING until an Admin decides. SUPERSEDED: the Campaign left Active
/// before a decision, so the request lapsed and must be made again.
enum CancellationRequestStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
}

/// A Fundraiser's request for Cancellation of their Active Campaign (see
/// CONTEXT.md). The Campaign stays Active, and keeps taking Donations, until
/// an Admin who is not its Fundraiser approves (Campaign becomes CANCELLED) or
/// rejects it. Written only by src/lib/campaign-lifecycle.ts, which keeps at
/// most one PENDING request per Campaign inside a transaction that holds the
/// Campaign row lock.
///
/// decidedById is null for a SUPERSEDED request, which nobody decided;
/// decidedAt is then the moment it lapsed. onDelete: Restrict on every
/// relation, like CampaignStatusChange: deleting a Campaign or a person must
/// never erase who asked for a Cancellation and who decided it.
model CancellationRequest {
  id             String                    @id @default(cuid())
  campaignId     String
  requestedById  String
  reason         String
  status         CancellationRequestStatus @default(PENDING)
  decidedById    String?
  decisionReason String?
  createdAt      DateTime                  @default(now())
  decidedAt      DateTime?

  // Relations
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  requestedBy User     @relation("CancellationRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy   User?    @relation("CancellationDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([campaignId, status])
}

/// How a Flag ended: the Campaign was suspended, or an Admin dismissed it.
enum FlagResolution {
  SUSPENDED
  DISMISSED
}

/// A Verifier's report that a Campaign needs to be considered for Suspension,
/// with a reason (see CONTEXT.md, Flag). A Campaign can carry several Flags,
/// each kept separately with its author. Open while resolution is null; it
/// ends when an Admin suspends the Campaign (every open Flag becomes
/// SUSPENDED, resolved by that Admin, in the same transaction) or when an
/// Admin who is not the Campaign's Fundraiser dismisses it with a reason.
/// Written only by src/lib/campaign-lifecycle.ts.
///
/// resolutionReason carries the Suspension's reason for a SUSPENDED Flag and
/// the dismissal reason for a DISMISSED one. onDelete: Restrict on every
/// relation, like the other lifecycle records: deleting a Campaign or a person
/// must never erase who reported it and who decided.
model CampaignFlag {
  id               String          @id @default(cuid())
  campaignId       String
  verifierId       String
  reason           String
  createdAt        DateTime        @default(now())
  resolution       FlagResolution?
  resolvedById     String?
  resolutionReason String?
  resolvedAt       DateTime?

  // Relations
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  verifier   User     @relation("FlagVerifier", fields: [verifierId], references: [id], onDelete: Restrict)
  resolvedBy User?    @relation("FlagResolver", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([campaignId, resolution])
}

// ==================== Donation ====================

model Donation {
  id            String   @id @default(cuid())
  amount        Int
  isAnonymous   Boolean  @default(false)
  paymentMethod String
  paymentStatus String   @default("pending") // "pending" | "confirmed" | "failed"
  message       String?  @db.VarChar(500)
  campaignId    String
  donorId       String?
  createdAt     DateTime @default(now())

  // Relations
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  donor    User?    @relation(fields: [donorId], references: [id], onDelete: SetNull)
  prayer   Prayer?

  payment Payment?

  @@index([campaignId])
  @@index([donorId])
  @@index([paymentStatus])
  @@index([createdAt])
}

// ==================== Prayer ====================

model Prayer {
  id         String   @id @default(cuid())
  text       String   @db.VarChar(500)
  amiinCount Int      @default(0)
  donationId String   @unique
  campaignId String
  userId     String?
  createdAt  DateTime @default(now())

  // Relations
  donation Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([createdAt])
  @@index([userId])
}

// ==================== Campaign Update ====================

model CampaignUpdate {
  id         String   @id @default(cuid())
  title      String
  content    String   @db.Text
  images     String[]
  campaignId String
  createdAt  DateTime @default(now())

  // Relations
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([createdAt])
}

// ==================== Notification ====================

model Notification {
  id        String   @id @default(cuid())
  type      String // "donation_confirmed" | "campaign_update" | "disbursement"
  title     String
  message   String
  isRead    Boolean  @default(false)
  userId    String
  link      String?
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
}

// ==================== Auto Donation ====================

model AutoDonation {
  id        String   @id @default(cuid())
  amount    Int
  category  String
  schedule  String // "daily" | "weekly"
  time      String // "HH:mm" format
  isActive  Boolean  @default(true)
  userId    String
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

// ==================== Category ====================

model Category {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  icon  String
  order Int    @default(0)

  @@index([slug])
  @@index([order])
}

// ==================== Money ====================
//
// Everything below is the money layer. It did not exist: donations carried a
// free-text `paymentStatus` that an unauthenticated endpoint could set, there
// was no record of a provider charge, no refunds, no bank accounts, no payout
// approval, and no ledger. A platform in that state can display totals but
// cannot answer "where is the money", which is the only question that matters
// when someone asks.
//
// THREE RULES THIS SECTION IS BUILT ON
//
// 1. Amounts are Int rupiah, matching Donation.amount and Campaign.targetAmount
//    already in this schema. IDR has no circulating minor unit, so there is no
//    cents problem to solve, and Int avoids float entirely. Never introduce a
//    Float for money here.
//
// 2. Status is an enum, never a String. The free-text paymentStatus is what let
//    "confirmed", "pending" and anything else coexist with no constraint; the
//    database should refuse an invalid state, not hope callers behave.
//
// 3. The ledger is double-entry and append-only. Balances are derived by
//    summing entries, never stored as a mutable column. Campaign.collectedAmount
//    stays as a denormalised display figure, but it stops being the source of
//    truth -- LedgerEntry is.

enum PaymentStatus {
  PENDING // created at the provider, awaiting the payer
  PAID // provider confirmed settlement
  EXPIRED // payment window closed unpaid
  FAILED // provider rejected it
  REFUNDED // fully refunded; partial refunds stay PAID with Refund rows
}

enum RefundStatus {
  REQUESTED
  AWAITING_DONOR_DETAILS
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  FAILED
}

enum PayoutStatus {
  // A payout is money leaving the platform, so it gets an explicit approval
  // step that cannot be skipped by a status write.
  DRAFT // campaigner is filling it in
  SUBMITTED // awaiting review
  APPROVED // reviewed, not yet sent
  REJECTED
  PROCESSING // instructed to the bank
  COMPLETED // funds confirmed out
  FAILED
}

enum LedgerAccount {
  // Named accounts rather than free strings, so a typo cannot silently create
  // a new account that never balances.
  ESCROW_HOLD // settled at the provider, still inside the dispute window
  CAMPAIGN_BALANCE // owed to a specific campaign, withdrawable now
  TRIP_BALANCE
  /// Money moved out of ESCROW_HOLD or the withdrawable balance the moment a
  /// Refund is created -- no longer visible as available, no longer eligible
  /// for a Payout, remaining the Donor's right until the (out-of-scope for
  /// this ticket) COMPLETED transition. See CONTEXT.md's "Frozen Balance".
  FROZEN_BALANCE
  PLATFORM_FEE // retained by the platform
  PROVIDER_FEE // retained by the payment provider
  GATEWAY_CLEARING // money at the provider, not yet settled to us
  PAYOUT_CLEARING // money instructed out, not yet confirmed
  REFUND_CLEARING
  /// The platform's absorption of whatever a Refund's source didn't cover --
  /// the unrecoverable Provider Fee on every Gross refund (ADR 0007), and,
  /// when the subject's pool has gone negative, the uncovered shortfall too.
  REFUND_COST
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

/// A charge attempt at a payment provider. One Donation has at most one
/// Payment; a retry creates a NEW Payment rather than mutating the old one, so
/// the history of attempts survives.
model Payment {
  id          String        @id @default(cuid())
  donationId  String?       @unique
  donation    Donation?     @relation(fields: [donationId], references: [id], onDelete: Restrict)
  /// Set instead of donationId for a Trip Fee payment -- exactly one of the
  /// two is ever set, enforced by assertExactlyOnePaymentSubject
  /// (./src/lib/money/payment-subject.ts), not by a schema constraint
  /// Prisma cannot express. onDelete: Restrict, matching donationId's own
  /// pinning -- a fresh optional relation defaults to Prisma's implicit
  /// SetNull otherwise, the exact class of bug a whole-branch review on an
  /// earlier ticket caught for donationId/campaignId. Applied here
  /// proactively.
  registrationId String?       @unique
  registration   Registration? @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  provider    String // "midtrans" | "xendit" | ... kept a String: providers are added without a migration
  method      String // "qris" | "va_bca" | ...
  /// The provider's own id for this charge. Unique so a webhook replay cannot
  /// create a second Payment for the same upstream charge.
  providerRef String        @unique
  amount      Int
  /// What the provider kept. Recorded separately so the campaign is credited
  /// the net, and the fee is visible rather than silently missing.
  providerFee Int           @default(0)
  status      PaymentStatus @default(PENDING)
  /// Provider payload, kept verbatim for dispute resolution. Never parsed for
  /// business logic -- the typed columns above are what the app reads.
  rawPayload  Json?
  paidAt      DateTime?
  expiresAt   DateTime?

  /// When this payment's money stops being escrow and becomes withdrawable.
  /// Set on settlement to paidAt + the hold period; null while unpaid.
  ///
  /// The hold exists so a refund or a dispute has somewhere to land. Without
  /// it, a donation can be paid out to the campaigner before the donor's bank
  /// has finished deciding whether the charge was theirs, and the platform is
  /// then chasing money it has already sent away.
  escrowReleaseAt   DateTime?
  /// Stamped when the release entries are actually posted. Together with the
  /// field above this is the sweep's whole state: due is `escrowReleaseAt <=
  /// now AND escrowReleasedAt IS NULL`, which is also why they share an index.
  escrowReleasedAt  DateTime?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  refunds       Refund[]
  ledgerEntries LedgerEntry[]

  @@index([status])
  @@index([provider, status])
  @@index([escrowReleaseAt, escrowReleasedAt])
}

/// Every webhook the platform has accepted, by provider event id.
///
/// Exists solely so a replayed or duplicated webhook is a no-op. Providers
/// retry aggressively and do not promise exactly-once delivery; without this,
/// a retry credits the campaign twice.
model WebhookEvent {
  id              String    @id @default(cuid())
  provider        String
  /// The provider's event id. The unique constraint IS the idempotency
  /// mechanism -- the insert fails on a replay, and the handler returns 200
  /// without touching anything else.
  providerEventId String
  payload         Json
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?

  @@unique([provider, providerEventId])
  @@index([provider, receivedAt])
}

model Refund {
  id            String       @id @default(cuid())
  paymentId     String
  payment       Payment      @relation(fields: [paymentId], references: [id])
  /// Partial refunds are allowed, so this is not necessarily the full payment.
  amount        Int
  reason        String
  status        RefundStatus @default(REQUESTED)
  requestedById String
  requestedBy   User         @relation("RefundRequester", fields: [requestedById], references: [id])
  /// Who approved it. Refunds move money back out, so they are attributable.
  approvedById  String?
  approvedBy    User?        @relation("RefundApprover", fields: [approvedById], references: [id])
  providerRef   String?      @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  ledgerEntries LedgerEntry[]

  @@index([status])
  @@index([paymentId])
}

/// Where a campaign's money is sent. Separate from the campaign so the account
/// can be verified once and reused, and so changing it is an auditable event
/// rather than an edit to the campaign row.
model BankAccount {
  id            String    @id @default(cuid())
  ownerId       String
  owner         User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bankCode      String
  /// Stored in full. This is a payout destination, not a card number -- it has
  /// to be readable to instruct the transfer, and masking happens at the UI.
  accountNumber String
  accountName   String
  /// Set only once the name has been checked against the bank's records.
  /// Payouts must refuse an unverified destination.
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())

  payouts Payout[]

  @@unique([ownerId, bankCode, accountNumber])
  @@index([ownerId])
}

/// Money leaving the platform to a campaign's bank account.
///
/// Replaces the previous Disbursement model, which had no status, no approver,
/// and no destination -- it recorded that a payout had supposedly happened
/// without any of the facts that make it checkable.
model Payout {
  id            String       @id @default(cuid())
  campaignId    String?
  campaign      Campaign?    @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  /// Set instead of campaignId for a Volunteer Trip payout. Plain scalar,
  /// no @relation: neither this nor any other ticket has needed .include()
  /// through it yet (routes compare it as a plain scalar, same as
  /// campaignId's own comparisons). Add the relation whenever a caller
  /// actually needs it.
  volunteerTripId String?
  bankAccountId String
  bankAccount   BankAccount  @relation(fields: [bankAccountId], references: [id])
  amount        Int
  description   String
  /// Evidence of the transfer. Required before COMPLETED, enforced in the
  /// service layer rather than the schema because Prisma cannot express a
  /// conditional NOT NULL.
  proofImage    String?
  status        PayoutStatus @default(DRAFT)

  requestedById   String
  requestedBy     User      @relation("PayoutRequester", fields: [requestedById], references: [id])
  /// Two-person rule: the approver must not be the requester. Enforced in the
  /// service layer, and the columns exist so it is auditable after the fact.
  approvedById    String?
  approvedBy      User?     @relation("PayoutApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String?

  providerRef String?   @unique
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  ledgerEntries LedgerEntry[]

  @@index([campaignId, status])
  @@index([volunteerTripId, status])
  @@index([status])
}

/// Double-entry ledger. Append-only: rows are never updated or deleted, and a
/// correction is a new pair of entries, not an edit.
///
/// Every movement writes at least two rows summing to zero across DEBIT and
/// CREDIT. A campaign's withdrawable balance is
///   sum(CREDIT) - sum(DEBIT) on CAMPAIGN_BALANCE for that campaign,
/// computed on read. Campaign.collectedAmount remains as a display figure and
/// is no longer authoritative.
model LedgerEntry {
  id        String          @id @default(cuid())
  account   LedgerAccount
  direction LedgerDirection
  amount    Int

  /// Which campaign this entry belongs to, where the account is
  /// campaign-scoped. Null for platform-level accounts.
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  /// Trip-scoped sibling of campaignId, same optionality shape. Plain
  /// scalar, no @relation: VolunteerTrip doesn't exist yet -- Ticket 02
  /// adds the relation once it does.
  volunteerTripId String?

  /// Exactly one of these is set, naming what caused the movement.
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id])
  refundId  String?
  refund    Refund?  @relation(fields: [refundId], references: [id])
  payoutId  String?
  payout    Payout?  @relation(fields: [payoutId], references: [id])

  /// Groups the entries of one balanced transaction. Every entry sharing a
  /// transactionId must sum to zero; that invariant is asserted in tests and
  /// by a periodic check, since Prisma cannot express it as a constraint.
  transactionId String
  memo          String?
  createdAt     DateTime @default(now())

  @@index([transactionId])
  @@index([account, campaignId])
  @@index([account, volunteerTripId])
  @@index([campaignId, createdAt])
}

/// The old `Disbursement` table, renamed rather than dropped by the money-layer
/// migration. Twelve real rows claiming money left the platform, with no status,
/// no approver and no destination account -- they cannot be turned into Payouts
/// without inventing the facts that make a Payout checkable.
///
/// Declared here for one reason: a table the schema does not know about is a
/// table the next `prisma migrate dev` writes a DROP TABLE for. Mapping it keeps
/// Prisma's drift detection from quietly proposing to delete the only copy.
///
/// Read-only. Nothing writes to this model. It should end as either a mapped set
/// of Payout rows or an export plus a drop -- a decision for whoever can say what
/// these twelve payouts actually were.
model DisbursementLegacy {
  /// The pk and index keep their pre-rename names. Mapping them is one line;
  /// renaming them is DDL against a live table for no gain but tidiness.
  id          String   @id(map: "Disbursement_pkey")
  amount      Int
  description String
  proofImage  String?
  campaignId  String
  createdAt   DateTime @default(now())

  @@index([campaignId], map: "Disbursement_campaignId_idx")
  @@map("Disbursement_legacy")
}

// ==================== Volunteer Trip ====================

enum VolunteerTripStatus {
  DRAFT
  SUBMITTED
  REJECTED
  ACTIVE
  SUSPENDED
  CANCELLED
  COMPLETED
}

/// A Fundraiser-owned catalog item: destination, itinerary, and a Trip Fee
/// shared across every Batch of this Trip. Deliberately not a Campaign and
/// not a Kind -- see ADR 0014. Shaped like Campaign minus targetAmount/
/// deadline/isUrgent/isDemo, plus destination/itinerary/tripFeeAmount.
model VolunteerTrip {
  id            String              @id @default(cuid())
  slug          String              @unique
  title         String
  description   String              @db.Text
  story         String              @db.Text
  coverImage    String
  destination   String
  itinerary     String              @db.Text
  tripFeeAmount Int
  status        VolunteerTripStatus @default(DRAFT)
  fundraiserId  String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  // Relations
  fundraiser User             @relation(fields: [fundraiserId], references: [id], onDelete: Cascade)
  batches    VolunteerBatch[]

  @@index([slug])
  @@index([status])
  @@index([fundraiserId])
}

enum VolunteerBatchStatus {
  OPEN
  CLOSED
  CANCELLED
  COMPLETED
}

/// One dated instance of a Volunteer Trip. maxQuota/minQuota are Fundraiser-
/// set per Batch, never a platform-wide constant (ADR 0014). This ticket
/// only ever produces OPEN; the rest of the enum exists so a later ticket
/// (Registration, Batch cancellation) needs no schema change to use it.
model VolunteerBatch {
  id                   String               @id @default(cuid())
  tripId               String
  startDate            DateTime
  endDate              DateTime
  registrationDeadline DateTime
  maxQuota             Int
  minQuota             Int
  status               VolunteerBatchStatus @default(OPEN)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  // Relations
  trip           VolunteerTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  registrations  Registration[]

  @@index([tripId])
  @@index([status])
}

enum RegistrationStatus {
  HOLD
  CONFIRMED
  EXPIRED
  CANCELLED
}

/// A Volunteer's registration on one Volunteer Batch. HOLD and CONFIRMED
/// together count toward the Batch's maxQuota; only CONFIRMED counts toward
/// minQuota. status is denormalized from this Registration's Payment.status,
/// kept in sync by the settlement webhook (Task 3) and the
/// hold-expiry sweep (Task 2), never by this Registration being written
/// directly outside those two paths.
model Registration {
  id            String             @id @default(cuid())
  volunteerId   String
  batchId       String
  status        RegistrationStatus @default(HOLD)
  holdExpiresAt DateTime
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  // Relations
  volunteer User           @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  batch     VolunteerBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  payment   Payment?

  @@index([volunteerId])
  @@index([batchId])
  @@index([status])
  @@index([holdExpiresAt])
}
