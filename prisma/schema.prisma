// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================== Enums ====================

enum Assignment {
  VERIFIER
  ADMIN
}

enum Role {
  ADMIN
  MODERATOR
  CAMPAIGN_CREATOR
  DONOR
}

// ==================== User & Auth ====================

model User {
  id               String   @id @default(cuid())
  name             String
  password         String?
  avatar           String?
  // Field-level protection (ADR 0012), contract step (prd-compliance 16): the
  // plaintext `email` and `phone` columns are gone, so a stolen database dump
  // no longer hands over a Donor address. The columns below are written and
  // read through src/lib/contact-fields.ts, and the client hook in
  // src/lib/field-protection.ts seals any plaintext a caller hands it rather
  // than letting it through. `name` stays plaintext by decision, not by
  // omission: it is already shown publicly, and Refund compares it.
  //
  // What this is for, plainly: a dump of this database no longer contains a
  // readable Donor address or phone number. What it is NOT for: an Admin with
  // panel access can still read any of them, because the panel decrypts on the
  // way out. There is no access log on the panel today, so that is a separate
  // piece of work (ADR 0012, Consequences).
  /// Hex HMAC-SHA256 of the trimmed, lowercased email under FIELD_HMAC_KEY. Searchable.
  emailHmac        String   @unique
  emailHmacKeyId   String
  /// base64(iv | AES-256-GCM ciphertext | tag) of the email under FIELD_ENCRYPTION_KEY.
  emailCiphertext  String
  emailKeyId       String
  phoneCiphertext  String?
  phoneKeyId       String?
  // Retired: the self-claimed verification and the Role hierarchy. No
  // application code or seed reads or writes them (retire-role-hierarchy
  // 02); authority comes only from assignments (ADR 0005). Nullable and
  // ignored until ticket 03 drops them with the Role enum.
  isVerified       Boolean?
  verificationType String?
  role             Role?
  donationBalance  Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  accounts                         Account[]
  campaigns                        Campaign[]
  volunteerTrips                   VolunteerTrip[]
  registrations                    Registration[]
  donations                        Donation[]
  prayers                          Prayer[]
  notifications                    Notification[]
  autoDonations                    AutoDonation[]
  assignments                      UserAssignment[]
  assignmentAuditsAsSubject        AssignmentAuditEntry[]            @relation("AssignmentAuditSubject")
  assignmentAuditsAsActor          AssignmentAuditEntry[]            @relation("AssignmentAuditActor")
  assignmentGrantRequestsAsSubject AssignmentGrantRequest[]          @relation("AssignmentGrantSubject")
  assignmentGrantRequestsProposed  AssignmentGrantRequest[]          @relation("AssignmentGrantProposer")
  assignmentGrantRequestsDecided   AssignmentGrantRequest[]          @relation("AssignmentGrantDecider")
  campaignStatusChanges            CampaignStatusChange[]
  tripStatusChanges                VolunteerTripStatusChange[]
  partnershipInquiryStatusChanges  PartnershipInquiryStatusChange[]
  cancellationRequestsMade         CancellationRequest[]             @relation("CancellationRequester")
  cancellationRequestsDecided      CancellationRequest[]             @relation("CancellationDecider")
  campaignFlagsRaised              CampaignFlag[]                    @relation("FlagVerifier")
  campaignFlagsResolved            CampaignFlag[]                    @relation("FlagResolver")
  verificationRequestsSubmitted    VerificationRequest[]             @relation("VerificationRequestSubmitter")
  verificationRequestsDecided      VerificationRequest[]             @relation("VerificationRequestDecider")
  identityVerification             IdentityVerification?             @relation("IdentityVerificationSubject")
  identityVerificationsMade        IdentityVerification[]            @relation("IdentityVerificationVerifier")
  checklistAuditEntries            VerificationChecklistAuditEntry[]
  partnerOrganisation              PartnerOrganisation?              @relation("PartnerOrganisationFundraiser")
  partnerOrganisationsRegistered   PartnerOrganisation[]             @relation("PartnerOrganisationRegistrar")
  fundraisingPermitsRecorded       FundraisingPermit[]
  kindAuthorisationsGranted        KindAuthorisation[]
  partnerOrganisationAudits        PartnerOrganisationAuditEntry[]

  // Money layer
  bankAccounts                      BankAccount[]
  bankAccountVerificationsSubmitted BankAccountVerificationRequest[] @relation("BankAccountVerificationSubmitter")
  bankAccountVerificationsDecided   BankAccountVerificationRequest[] @relation("BankAccountVerificationDecider")
  bankAccountRevocations            BankAccountRevocation[]          @relation("BankAccountRevocationActor")
  payoutsRequested                  Payout[]                         @relation("PayoutRequester")
  payoutsApproved                   Payout[]                         @relation("PayoutApprover")
  payoutsCompleted                  Payout[]                         @relation("PayoutCompleter")
  payoutBalanceChecksRecorded       PayoutBalanceCheck[]              @relation("PayoutBalanceCheckedBy")
  usageReportsSubmitted             UsageReport[]                    @relation("UsageReportSubmitter")
  usageReportsDisputed              UsageReport[]                    @relation("UsageReportDisputer")
  refundsRequested                  Refund[]                         @relation("RefundRequester")
  refundsApproved                   Refund[]                         @relation("RefundApprover")
  refundsCompleted                  Refund[]                         @relation("RefundCompleter")
  platformFeeRulesSet               PlatformFeeRule[]
  platformFeeThresholdsSet          PlatformFeeThreshold[]
  manualContributionsRecorded       ManualContribution[]             @relation("ManualContributionRecorder")
  manualContributionsDecided        ManualContribution[]             @relation("ManualContributionDecider")
  manualContributionsReversed       ManualContribution[]             @relation("ManualContributionReverser")
  providerWithdrawalsRecorded       ProviderWithdrawal[]             @relation("ProviderWithdrawalRecorder")
  duplicateSimilarityThresholdsSet  DuplicateSimilarityThreshold[]
  abuseThresholdsSet                AbuseThreshold[]

  // One account per address, and it is the normalized address that counts: the
  // old `email @unique` was case-sensitive and would let one person hold
  // `Andi@x.id` and `andi@x.id` as two accounts. The lookup HMAC is computed
  // from the lowercased address, so those two collide on the `@unique` above and
  // cannot. That unique index is also the lookup index every `lookupUserEmail`
  // query uses, so the plain `@@index([emailHmac])` the expand step added is
  // dropped with it rather than left as a second index on one column.
}

/// Verifier and Admin are assignments a person holds, not ranks.
/// One person may hold both; holding both is two rows, never a special
/// case. See ADR 0005. The `Role` hierarchy still governs access until
/// tickets 07-08 migrate the guards; this model only records who holds
/// what in the meantime.
model UserAssignment {
  userId     String
  assignment Assignment
  assignedAt DateTime   @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, assignment])
  @@index([assignment])
}

enum AssignmentAuditAction {
  GRANTED
  REVOKED
  /// An ADMIN grant proposed by one Admin, waiting on a different Admin to
  /// confirm (ticket 07/20). Recorded so the audit trail shows that a second
  /// person was asked, not only the finished grant.
  PROPOSED
}

/// One row per grant or revoke event, kept even after the UserAssignment
/// row itself is deleted on revoke. This is what lets granting, revoking,
/// and regranting the same assignment keep its full history -- a
/// soft-delete on UserAssignment itself would not, since that model's
/// composite primary key assumes one row per currently-held assignment.
model AssignmentAuditEntry {
  id         String                @id @default(cuid())
  userId     String
  assignment Assignment
  action     AssignmentAuditAction
  actedById  String
  actedAt    DateTime              @default(now())
  /// Optional, consistent with CampaignStatusChange.reason (ticket 07/20
  /// answer): why the grant or revoke was made, not required.
  reason     String?

  // Relations
  user    User @relation("AssignmentAuditSubject", fields: [userId], references: [id], onDelete: Cascade)
  actedBy User @relation("AssignmentAuditActor", fields: [actedById], references: [id])

  @@index([userId])
  @@index([assignment])
}

enum GrantRequestOutcome {
  PENDING
  CONFIRMED
  WITHDRAWN
}

/// The two-person half of granting ADMIN (ticket 07/20; CONTEXT.md, Admin):
/// one Admin proposes, a DIFFERENT Admin confirms, and the grantee may not
/// confirm their own grant. Mirrors BankAccountVerificationRequest (ticket
/// 16; ADR 0018) -- the same pending-request shape, a partial unique index
/// for "at most one PENDING request per grantee" instead of inventing a new
/// design. VERIFIER is not granted through this table: decision 07/20 keeps
/// that a single Admin's direct grant.
///
/// No expiry: like BankAccountVerificationRequest, a PENDING row waits
/// indefinitely for a second Admin, and a stale one can only be withdrawn by
/// its own proposer or superseded by a fresh confirm. That is the smallest
/// honest choice available now; an expiry was left open by the ticket and is
/// not decided here.
model AssignmentGrantRequest {
  id             String              @id @default(cuid())
  userId         String
  outcome        GrantRequestOutcome @default(PENDING)
  proposedById   String
  proposedAt     DateTime            @default(now())
  proposedReason String?
  /// The Admin who confirmed, or the proposer who withdrew their own request
  /// (the same "who closed it" shape BankAccountVerificationRequest.decidedById
  /// uses).
  decidedById    String?
  decidedAt      DateTime?
  decidedReason  String?

  // Relations
  user       User  @relation("AssignmentGrantSubject", fields: [userId], references: [id], onDelete: Cascade)
  proposedBy User  @relation("AssignmentGrantProposer", fields: [proposedById], references: [id], onDelete: Restrict)
  decidedBy  User? @relation("AssignmentGrantDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  /// The Admin queue: oldest PENDING first.
  @@index([outcome, proposedAt])
  /// One grantee's own history.
  @@index([userId, proposedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ==================== Campaign ====================

enum CampaignStatus {
  DRAFT
  SUBMITTED
  REJECTED
  ACTIVE
  SUSPENDED
  CANCELLED
  COMPLETED
  EXPIRED
}

/// Which money rules a Campaign follows (CONTEXT.md, Kind; ADR 0002, 0013).
/// A deadline is mandatory on every Kind except WAKAF. Fixed once the
/// Campaign leaves Draft (src/lib/subject-guard.ts, requireKindEditable).
enum Kind {
  DONATION
  ZAKAT
  WAKAF
  HIBAH
}

/// How CSR Programs are grouped for the portfolio (CONTEXT.md, Sector).
/// Fixed in code: there is no Admin panel, table, or API that adds, removes,
/// or renames a value. Deliberately a separate enum from Campaign's Category
/// model -- the two groupings answer different questions (CSR collaboration
/// area vs. donation appeal theme) and must never share a type or a table.
enum Sector {
  HEALTH
  EDUCATION
  ENVIRONMENT
  DISABILITY_INCLUSION
}

/// A CSR collaboration catalog item (CONTEXT.md, Program; ticket csr-01).
/// Read by company CSR teams; it never takes money online, so it carries no
/// Kind and no relation any Donation, Payment, Refund, Payout, or ledger code
/// path can reach. Money the platform can account for arrives as a Manual
/// Contribution naming this Program, credited to PROGRAM_BALANCE (FFI-07c,
/// prd-compliance 34) -- the contribution row below is the only way a
/// Program id reaches the money layer, and it is a write, never a read by
/// online-money code. Money that never crossed the platform's account is only
/// the plain reportedAmount figure below, kept apart from the ledger on
/// purpose (ticket csr-08).
model Program {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  sector         Sector
  problem        String    @db.Text
  beneficiaries  String    @db.Text
  location       String
  activities     String    @db.Text
  /// Planned need in rupiah (Int, like every other money figure here).
  budget         Int
  /// Free-text schedule (e.g. "Jan–Des 2027"), not a deadline with rules.
  timeline       String
  kpis           String[]
  documentation  String[]
  /// Written once the work can show results; null until then.
  impactReport   String?   @db.Text
  /// Plain reported figure for CSR money that never crossed the platform's
  /// account: no ledger entry behind it, by design. Only an Admin writes it.
  reportedAmount Int       @default(0)
  reportedAsOf   DateTime?
  reportedNote   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  /// Manual Contributions that name this Program. Inert on its own: nothing
  /// in the Donation, Payment, Refund, Payout or escrow paths reads it, and
  /// no back-relation onto a money model exists in the other direction --
  /// LedgerEntry.programId is a bare scalar, deliberately, so the word
  /// "ledger" never has to appear here (program-money-isolation.test.ts).
  manualContributions  ManualContribution[]
  /// The opposite end of every Partnership Inquiry about this Program. The
  /// only way a Program is ever reached from the outside; it carries no money
  /// either way, so a Program still cannot be given to or paid from.
  partnershipInquiries PartnershipInquiry[]

  @@index([sector])
}

/// How far the partnership team has taken a Partnership Inquiry along
/// (CONTEXT.md, Partnership Inquiry; ticket csr-05). A new Inquiry always
/// starts at NOT_YET_FOLLOWED_UP; ticket csr-06 moves it forward and records
/// who did so and when.
enum PartnershipInquiryStatus {
  NOT_YET_FOLLOWED_UP
  IN_PROGRESS
  DONE
}

/// One company's proposal to discuss a collaboration on a single Program
/// (CONTEXT.md, Partnership Inquiry; ticket csr-05). Submitted by an
/// unauthenticated public form and answered by the partnership team, so it
/// carries contact details -- a named person, so ADR 0012 protects them the same
/// way it protects a Donor's (see src/lib/field-protection.ts) -- and it moves
/// no money: the Program itself never takes money online, and an Inquiry is not
/// an entity that can hold any.
model PartnershipInquiry {
  id                     String                           @id @default(cuid())
  programId              String
  program                Program                          @relation(fields: [programId], references: [id], onDelete: Restrict)
  companyName            String
  /// Plaintext by decision (ADR 0012), same as User.name: it is what the
  /// partnership team reads to reply.
  contactName            String
  /// The company's description of what it wants to discuss, in its words.
  needs                  String                           @db.Text
  /// Hex HMAC-SHA256 of the trimmed, lowercased contact email under
  /// FIELD_HMAC_KEY. Searchable; lets the partnership team find every Inquiry
  /// from one company contact without reading a ciphertext.
  contactEmailHmac       String
  contactEmailHmacKeyId  String
  /// base64(iv | AES-256-GCM ciphertext | tag) of the contact email under FIELD_ENCRYPTION_KEY.
  contactEmailCiphertext String
  contactEmailKeyId      String
  /// The contact phone is optional -- plenty of counterparties have one number
  /// and no other -- and is never searched, so ciphertext only: no HMAC, same
  /// as User.phone and Donation.guestPhone.
  contactPhoneCiphertext String?
  contactPhoneKeyId      String?
  status                 PartnershipInquiryStatus         @default(NOT_YET_FOLLOWED_UP)
  /// The follow-up steps taken on it, oldest first; written only by
  /// src/lib/partnership-inquiry-followup.ts. The second relation this model
  /// has, and the only one besides its Program: never money.
  statusChanges          PartnershipInquiryStatusChange[]
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt

  @@index([programId])
  @@index([status])
  @@index([contactEmailHmac])
}

/// One follow-up step of a Partnership Inquiry (CONTEXT.md, Partnership
/// Inquiry; ticket csr-06): who moved it, from which status to which, and when.
/// Append-only, in the same transaction as the move itself, like
/// CampaignStatusChange: the queue's current status says where the
/// conversation is, and this says who took it there.
///
/// `actedById` is named the way AssignmentAuditEntry and
/// PartnerOrganisationAuditEntry name theirs, not the way CampaignStatusChange
/// names its actor, because a follow-up is taken in no Capacity: whoever holds
/// the ADMIN assignment moves the queue, and there is no Fundraiser to be.
/// There is no `reason` here either, because nobody outside the partnership
/// team is refused or told anything by a follow-up -- a Campaign's status
/// change changes what a Donor may give, and this changes only the team's own
/// queue.
///
/// onDelete: Restrict on both relations, as CampaignStatusChange does:
/// deleting an Inquiry or a person must never erase who followed it up and
/// when.
model PartnershipInquiryStatusChange {
  id         String                   @id @default(cuid())
  inquiryId  String
  fromStatus PartnershipInquiryStatus
  toStatus   PartnershipInquiryStatus
  /// Never null: no job and no scheduled task moves an Inquiry forward, only
  /// a member of the partnership team.
  actedById  String
  actedAt    DateTime                 @default(now())

  // Relations
  inquiry PartnershipInquiry @relation(fields: [inquiryId], references: [id], onDelete: Restrict)
  actedBy User               @relation(fields: [actedById], references: [id], onDelete: Restrict)

  @@index([inquiryId, actedAt])
}

model Campaign {
  id                     String         @id @default(cuid())
  slug                   String         @unique
  title                  String
  description            String         @db.Text
  story                  String         @db.Text
  coverImage             String
  targetAmount           Int
  collectedAmount        Int            @default(0)
  category               String
  /// Existing Campaigns were backfilled to DONATION by the migration that
  /// added this column; POST /api/campaigns always writes it explicitly.
  kind                   Kind           @default(DONATION)
  // Legacy status string: no application code or seed reads or writes it
  // (legacy-status-contract 02). Nullable and ignored until ticket 03 drops
  // it with its index.
  status                 String?
  // A new Campaign is a Draft until its Fundraiser submits it (FFI-04).
  lifecycleStatus        CampaignStatus @default(DRAFT)
  isUrgent               Boolean        @default(false)
  deadline               DateTime?
  /// Stamped once the scheduled job (runScheduledJobs, ticket 20) sends the
  /// deadline reminder to this Campaign's Fundraiser. Null until then, so the
  /// same reminder is never sent twice -- claimed via a predicated
  /// `updateMany` (WHERE deadlineReminderSentAt IS NULL) before sending,
  /// mirroring Payment.escrowReleasedAt's own claim pattern, so two
  /// overlapping scheduler runs still send exactly one reminder.
  deadlineReminderSentAt DateTime?
  creatorId              String
  /// The Partner Organisation under whose Fundraising Permit this Campaign
  /// collects (CONTEXT.md, Collecting Entity; ADR 0010). Always a Partner
  /// Organisation, so the Platform Operator can never be one. Null on a
  /// Draft that has not named one yet and on a Campaign that predates this
  /// column; neither accepts a Donation (campaignAcceptsDonations), and
  /// submitCampaign refuses a Campaign without one.
  collectingEntityId     String?
  /// Where this Campaign happens, free text and nullable, the way
  /// `category` is (ticket 25, "Impact & Transparency"). One field rather
  /// than a province and a regency/city pair on purpose: nothing in this
  /// codebase has a taxonomy of Indonesian provinces to validate against,
  /// and inventing one here would be a guess the campaign form (FFI-02 /
  /// FFI-04, Fase 1) would then have to live with. The Impact page's
  /// location filter reads this column today and matches it case-
  /// insensitively as a substring, so "Jawa" covers Jawa Barat and Jawa
  /// Tengah. Null until a Campaign form writes one -- a Campaign with no
  /// location simply matches no location filter, which is honest rather
  /// than quietly counted as everywhere.
  location               String?
  /// The beneficiary this Campaign names (PRD FFI-02, FFI-05). Plaintext,
  /// never encrypted: ADR 0012 keeps names readable precisely so they can be
  /// compared, and "identical beneficiary name" is one of the three matches
  /// a Verifier's duplicate hints are built from (prd-compliance 14). A
  /// ciphertext would make that question unanswerable. Nullable until a
  /// Campaign form writes one; a Campaign that names no beneficiary matches
  /// no other Campaign on this, which is what the statement in
  /// src/lib/duplicate-hints.ts relies on.
  beneficiaryName        String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  /// Sample/demo content, not a real appeal. Set by a one-time migration for
  /// the 30 campaigns that existed before the money layer (task M9) -- every
  /// one of them had zero Payment rows behind any of their donations, which
  /// is what proves they predate real money rather than a date this schema
  /// would have to keep in sync. NEVER set true by application code: `false`
  /// is the only default, a new campaign never inherits it, and nothing in
  /// this codebase should ever flip it back on. It is enforcement, not just
  /// a label -- POST /api/donations and requestPayout (src/lib/money/
  /// payouts.ts) both refuse a campaign with this flag before writing
  /// anything, and GET /api/admin/reconcile excludes it from its comparison
  /// entirely, because its collectedAmount is fixture data with no ledger
  /// behind it by design.
  ///
  /// DO NOT REUSE THE M9 MIGRATION ON ANOTHER ENVIRONMENT. Its UPDATE is a
  /// one-time, environment-specific statement written for THIS database's
  /// state on 18 September 2026 -- it does not mean "created before task M9
  /// shipped", it means "has no Payment behind any of its donations YET".
  /// Applied anywhere that already holds real, unpaid-so-far campaigns (a
  /// fresh environment stood up as part of the planned dev/stg/prod split,
  /// for instance), it would mark every one of them isDemo and permanently
  /// block their donations. If a future environment needs its own demo data
  /// marked, write that environment a new migration with its own predicate
  /// -- do not point it at this one.
  isDemo Boolean @default(false)

  // Relations
  creator               User                   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  collectingEntity      PartnerOrganisation?   @relation(fields: [collectingEntityId], references: [id], onDelete: Restrict)
  donations             Donation[]
  updates               CampaignUpdate[]
  // Disbursement is replaced by Payout, which carries status, an approver and
  // a destination account -- see the Money section.
  payouts               Payout[]
  ledgerEntries         LedgerEntry[]
  prayers               Prayer[]
  statusChanges         CampaignStatusChange[]
  cancellationRequests  CancellationRequest[]
  flags                 CampaignFlag[]
  verificationRequests  VerificationRequest[]
  platformFeeRules      PlatformFeeRule[]
  /// Money recorded by an Admin as arriving outside the payment gateway
  /// (CONTEXT.md, Manual Contribution). Not a Donation: it has no Payment,
  /// no Donor and no Refund, and it can be taken back out by a reversal.
  manualContributions   ManualContribution[]
  auditMarker           CampaignAuditMarker?
  donationReviewMarkers DonationReviewMarker[]

  @@index([slug])
  @@index([category])
  @@index([kind])
  @@index([status])
  @@index([lifecycleStatus])
  @@index([creatorId])
  @@index([collectingEntityId])
  @@index([location])
  @@index([beneficiaryName])
  // The trigram index behind duplicate hints (prd-compliance 14): the GIN
  // index pg_trgm's `similarity()` can use as a search. The extension itself
  // is created by the migration, never by the application.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([isUrgent, status])
  @@index([lifecycleStatus, deadline])
}

enum CampaignStatusChangeAction {
  SUBMITTED
  SUBMISSION_APPROVED
  SUBMISSION_REJECTED
  SUBMISSION_WITHDRAWN
  COMPLETED
  SUSPENDED
  SUSPENSION_LIFTED
  CANCELLED
  EXPIRED
  URGENT_SET
  URGENT_CLEARED
  /// An Admin or Verifier named the Collecting Entity of an Active Campaign
  /// that had none (prd-compliance 10). Not a status change.
  COLLECTING_ENTITY_ASSIGNED
}

/// The capacity a person acted in (ADR 0005). One person may hold several
/// assignments; the record says which one this change was made under.
/// SYSTEM is a change nobody made by hand: lazy expiry, and Urgent dropping
/// because the Campaign left Active.
enum StatusChangeCapacity {
  FUNDRAISER
  VERIFIER
  ADMIN
  SYSTEM
}

/// Append-only record of every Campaign status change and every Urgent
/// change (PRD §9). Written only by src/lib/campaign-lifecycle.ts, in the
/// same transaction as the change itself; never updated or deleted. Lifting
/// a Suspension reads the latest SUSPENDED row for the status to restore
/// (ADR 0015), so this is load-bearing, not just an audit trail.
///
/// onDelete: Restrict on both relations, like Payout: deleting a Campaign
/// or a person must never erase who changed what. A Campaign with history
/// can therefore no longer be hard-deleted, which is the point.
model CampaignStatusChange {
  id         String                     @id @default(cuid())
  campaignId String
  action     CampaignStatusChangeAction
  /// Both null for URGENT_SET / URGENT_CLEARED, which change no status.
  fromStatus CampaignStatus?
  toStatus   CampaignStatus?
  /// Null exactly when capacity is SYSTEM.
  actorId    String?
  capacity   StatusChangeCapacity
  reason     String?
  createdAt  DateTime                   @default(now())

  // Relations
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  actor    User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([campaignId, createdAt])
}

/// PENDING until an Admin decides. SUPERSEDED: the Campaign left Active
/// before a decision, so the request lapsed and must be made again.
enum CancellationRequestStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
}

/// A Fundraiser's request for Cancellation of their Active Campaign (see
/// CONTEXT.md). The Campaign stays Active, and keeps taking Donations, until
/// an Admin who is not its Fundraiser approves (Campaign becomes CANCELLED) or
/// rejects it. Written only by src/lib/campaign-lifecycle.ts, which keeps at
/// most one PENDING request per Campaign inside a transaction that holds the
/// Campaign row lock.
///
/// decidedById is null for a SUPERSEDED request, which nobody decided;
/// decidedAt is then the moment it lapsed. onDelete: Restrict on every
/// relation, like CampaignStatusChange: deleting a Campaign or a person must
/// never erase who asked for a Cancellation and who decided it.
model CancellationRequest {
  id             String                    @id @default(cuid())
  campaignId     String
  requestedById  String
  reason         String
  status         CancellationRequestStatus @default(PENDING)
  decidedById    String?
  decisionReason String?
  createdAt      DateTime                  @default(now())
  decidedAt      DateTime?

  // Relations
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  requestedBy User     @relation("CancellationRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy   User?    @relation("CancellationDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([campaignId, status])
}

/// How a Flag ended: the Campaign was suspended, or an Admin dismissed it.
enum FlagResolution {
  SUSPENDED
  DISMISSED
}

/// A Verifier's report that a Campaign needs to be considered for Suspension,
/// with a reason (see CONTEXT.md, Flag). A Campaign can carry several Flags,
/// each kept separately with its author. Open while resolution is null; it
/// ends when an Admin suspends the Campaign (every open Flag becomes
/// SUSPENDED, resolved by that Admin, in the same transaction) or when an
/// Admin who is not the Campaign's Fundraiser dismisses it with a reason.
/// Written only by src/lib/campaign-lifecycle.ts.
///
/// resolutionReason carries the Suspension's reason for a SUSPENDED Flag and
/// the dismissal reason for a DISMISSED one. onDelete: Restrict on every
/// relation, like the other lifecycle records: deleting a Campaign or a person
/// must never erase who reported it and who decided.
model CampaignFlag {
  id               String          @id @default(cuid())
  campaignId       String
  verifierId       String
  reason           String
  createdAt        DateTime        @default(now())
  resolution       FlagResolution?
  resolvedById     String?
  resolutionReason String?
  resolvedAt       DateTime?

  // Relations
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  verifier   User     @relation("FlagVerifier", fields: [verifierId], references: [id], onDelete: Restrict)
  resolvedBy User?    @relation("FlagResolver", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([campaignId, resolution])
}

// ==================== Donation ====================

enum VerificationOutcome {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

/// One submission of a Campaign to a Verifier (CONTEXT.md, Verification
/// Request; FFI-05). Every submit creates a new row, so the history of
/// refusals survives; nothing is ever deleted. At most one is PENDING per
/// Campaign: only a Draft or Rejected Campaign can be submitted, and
/// submitting makes it Submitted, both under the Campaign row lock.
/// What a Verification Request is for. Two of the three are asked for by a
/// Fundraiser and decided by a Verifier; the third is raised by the System
/// because a Campaign's money crossed a threshold (prd-compliance 38).
enum VerificationRequestKind {
  /// Submitted from a Draft or Rejected Campaign. The only kind that moves
  /// the Campaign to Active or back to Rejected.
  SUBMISSION
  /// An Active Campaign asking for a new target or deadline; it keeps
  /// running on its old values until the request is decided (ticket 12).
  CHANGE
  /// The extra Verifier review a Campaign earns by crossing the cumulative
  /// Gross threshold (CONTEXT.md, Verifikasi Tambahan). Raised by the
  /// System, so it moves no status either way and the Fundraiser cannot
  /// withdraw it: a review the person under review could cancel is not a
  /// review.
  AMOUNT_REVIEW
}

model VerificationRequest {
  id                 String                  @id @default(cuid())
  campaignId         String
  /// Null only on an AMOUNT_REVIEW, which the System raises and no person
  /// submits (prd-compliance 38); `kind` is what says so.
  submittedById      String?
  submittedAt        DateTime                @default(now())
  /// The active checklist items as they stood at submission, with the
  /// Verifier's ticks: [{ id, label, required, position, ticked }].
  checklist          Json
  outcome            VerificationOutcome     @default(PENDING)
  reason             String?
  /// Who closed the request and when: the Verifier on APPROVED or REJECTED,
  /// the Fundraiser on WITHDRAWN. Null while PENDING.
  decidedById        String?
  decidedAt          DateTime?
  /// Submitted from Draft (the Campaign's first request) rather than from
  /// Rejected. A withdrawal returns the Campaign to Draft or Rejected by it.
  isFirst            Boolean
  /// A change asked for an Active Campaign (ticket 12, FFI-05): the new
  /// target and/or deadline the Campaign keeps running without until a
  /// Verifier approves this request. Null on every SUBMISSION and on every
  /// AMOUNT_REVIEW. Approving applies it; rejecting or withdrawing discards it.
  proposedChanges    Json?
  /// Which of the three kinds of request this is (prd-compliance 38).
  /// Backfilled from `proposedChanges` by the migration that added it, so
  /// every request already in the table says which kind it is instead of
  /// being inferred from a nullable JSON column.
  kind               VerificationRequestKind @default(SUBMISSION)
  /// Why the System raised an AMOUNT_REVIEW: the Campaign's Cumulative Gross
  /// and the threshold it had passed, as `{ cumulativeGross, threshold }`.
  /// Null on the other two kinds. Kept on the request rather than re-derived
  /// at read time, because the Verifier judges the Campaign as it stood when
  /// the review was raised, and a later Donation would move the number under
  /// them.
  raisedByAmount     Json?
  /// The Campaign's Collecting Entity when it was submitted: the one the
  /// Verifier confirms by approving (prd-compliance 10). Null on requests
  /// submitted before this column existed.
  collectingEntityId String?

  // Relations
  campaign         Campaign             @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  collectingEntity PartnerOrganisation? @relation(fields: [collectingEntityId], references: [id], onDelete: Restrict)
  submittedBy      User?                @relation("VerificationRequestSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  decidedBy        User?                @relation("VerificationRequestDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([outcome, submittedAt])
  @@index([campaignId, submittedAt])
}

/// A dated record that a Verifier checked a Fundraiser's identity, made when
/// their first Verification Request is approved (CONTEXT.md, Identity
/// Verification). Never claimed by the Fundraiser.
model IdentityVerification {
  id         String   @id @default(cuid())
  userId     String   @unique
  verifierId String
  verifiedAt DateTime @default(now())
  note       String?

  // Relations
  user     User @relation("IdentityVerificationSubject", fields: [userId], references: [id], onDelete: Restrict)
  verifier User @relation("IdentityVerificationVerifier", fields: [verifierId], references: [id], onDelete: Restrict)
}

// ==================== Partner Organisation (prd-compliance 10) ====================

/// An organisation running programs on the platform (CONTEXT.md, Partner
/// Organisation), registered by a Verifier after checking its legal
/// documents, with the one Fundraiser account that acts for it. The only
/// thing a Campaign's Collecting Entity can be (ADR 0010). Never deleted.
model PartnerOrganisation {
  id                         String   @id @default(cuid())
  name                       String
  /// The linked Fundraiser account. A Campaign it creates gets this
  /// organisation as its Collecting Entity automatically.
  fundraiserId               String   @unique
  /// Set by the Verifier: whether an individual Fundraiser may pick it as
  /// the sponsoring Collecting Entity of their Campaign.
  acceptsIndividualCampaigns Boolean  @default(false)
  registeredById             String
  registeredAt               DateTime @default(now())

  // Relations
  fundraiser           User                            @relation("PartnerOrganisationFundraiser", fields: [fundraiserId], references: [id], onDelete: Restrict)
  registeredBy         User                            @relation("PartnerOrganisationRegistrar", fields: [registeredById], references: [id], onDelete: Restrict)
  permits              FundraisingPermit[]
  kindAuthorisations   KindAuthorisation[]
  campaigns            Campaign[]
  providerWithdrawals  ProviderWithdrawal[]
  verificationRequests VerificationRequest[]
  auditEntries         PartnerOrganisationAuditEntry[]
}

/// A dated permit to collect public donations held by a Partner Organisation
/// (CONTEXT.md, Fundraising Permit), recorded by a Verifier. Valid from
/// `validFrom` to `validTo`, both inclusive, for the Kinds it lists. Never
/// deleted; a renewal is a new permit or a later `validTo`.
model FundraisingPermit {
  id                    String   @id @default(cuid())
  partnerOrganisationId String
  number                String
  issuer                String
  kinds                 Kind[]
  validFrom             DateTime
  validTo               DateTime
  recordedById          String
  recordedAt            DateTime @default(now())

  // Relations
  partnerOrganisation PartnerOrganisation             @relation(fields: [partnerOrganisationId], references: [id], onDelete: Restrict)
  recordedBy          User                            @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  auditEntries        PartnerOrganisationAuditEntry[]

  @@index([partnerOrganisationId, validTo])
}

/// A dated authorisation for a Partner Organisation to run Campaigns of one
/// non-donation Kind (CONTEXT.md, Kind Authorisation; ADR 0013), granted by a
/// Verifier from the institutional document it names. Distinct from the
/// Fundraising Permit (prd-compliance 10), which is the general social
/// fundraising licence: this is the per-Kind institutional clearance (amil
/// zakat, nazhir wakaf, or the Hibah placeholder) layered on top of it.
/// Valid from `validFrom` to `validTo`, both inclusive. Never deleted; a
/// renewal is a new authorisation or a later `validTo`.
model KindAuthorisation {
  id                    String    @id @default(cuid())
  partnerOrganisationId String
  kind                  Kind
  documentReference     String
  validFrom             DateTime
  validTo               DateTime
  grantedById           String
  grantedAt             DateTime  @default(now())
  /// Stamped once the scheduled job (runScheduledJobs, ticket 20) sends the
  /// 30-day expiry warning to this authorisation's Partner Organisation.
  /// Null until then; claimed via a predicated `updateMany` (WHERE
  /// expiryWarningSentAt IS NULL) before sending, same idempotency pattern as
  /// Campaign.deadlineReminderSentAt.
  expiryWarningSentAt   DateTime?

  // Relations
  partnerOrganisation PartnerOrganisation             @relation(fields: [partnerOrganisationId], references: [id], onDelete: Restrict)
  grantedBy           User                            @relation(fields: [grantedById], references: [id], onDelete: Restrict)
  auditEntries        PartnerOrganisationAuditEntry[]

  @@index([partnerOrganisationId, validTo])
  @@index([validTo, expiryWarningSentAt])
}

enum PartnerOrganisationAuditAction {
  REGISTERED
  UPDATED
  PERMIT_RECORDED
  PERMIT_UPDATED
  KIND_AUTHORISATION_GRANTED
  KIND_AUTHORISATION_UPDATED
}

/// Append-only audit of every Partner Organisation registration and change,
/// every Fundraising Permit recorded or changed, and every Kind Authorisation
/// granted or changed: who, when, before and after.
model PartnerOrganisationAuditEntry {
  id                    String                         @id @default(cuid())
  partnerOrganisationId String
  permitId              String?
  kindAuthorisationId   String?
  action                PartnerOrganisationAuditAction
  before                Json?
  after                 Json
  actedById             String
  actedAt               DateTime                       @default(now())

  // Relations
  partnerOrganisation PartnerOrganisation @relation(fields: [partnerOrganisationId], references: [id], onDelete: Restrict)
  permit              FundraisingPermit?  @relation(fields: [permitId], references: [id], onDelete: Restrict)
  kindAuthorisation   KindAuthorisation?  @relation(fields: [kindAuthorisationId], references: [id], onDelete: Restrict)
  actedBy             User                @relation(fields: [actedById], references: [id], onDelete: Restrict)

  @@index([partnerOrganisationId, actedAt])
}

/// The documents a Verifier checks on every submission (PRD §7.1), edited by
/// an Admin from the panel. Seeded with the "Semua" row by migration; each
/// submission snapshots the active items. Items are deactivated, never
/// deleted. `kind` scopes an item to one Kind (PRD §7.1, ticket 12); null is
/// the "Semua" row, snapshotted for every Kind.
model VerificationChecklistItem {
  id       String  @id @default(cuid())
  label    String
  required Boolean @default(true)
  position Int
  active   Boolean @default(true)
  kind     Kind?

  auditEntries VerificationChecklistAuditEntry[]

  @@index([active, position])
  @@index([kind, active, position])
}

enum VerificationChecklistAuditAction {
  CREATED
  UPDATED
}

/// One Admin change to a checklist item: who, when, and the item as it stood
/// before and after ({ label, required, position, active }). `before` is null
/// for CREATED. Append-only; items themselves are never deleted.
model VerificationChecklistAuditEntry {
  id        String                           @id @default(cuid())
  itemId    String
  action    VerificationChecklistAuditAction
  before    Json?
  after     Json
  actedById String
  actedAt   DateTime                         @default(now())

  // Relations
  item    VerificationChecklistItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  actedBy User                      @relation(fields: [actedById], references: [id], onDelete: Restrict)

  @@index([itemId, actedAt])
}

model Donation {
  id            String   @id @default(cuid())
  amount        Int
  isAnonymous   Boolean  @default(false)
  paymentMethod String
  paymentStatus String   @default("pending") // "pending" | "confirmed" | "failed"
  message       String?  @db.VarChar(500)
  campaignId    String
  donorId       String?
  createdAt     DateTime @default(now())

  /// A Guest Donor's contact details (CONTEXT.md, Guest Donor): required at
  /// the API when donorId is null, kept only for Receipt -- never shown
  /// publicly or to the Fundraiser (guestName follows the same isAnonymous
  /// rule as a registered donor's name, prd-compliance 18). Protected the
  /// same way a registered Donor's are (ADR 0012, contract step
  /// prd-compliance 16): the plaintext guestEmail and guestPhone columns are
  /// gone and only the sealed forms below remain. guestName is plaintext by
  /// decision, same as User.name and BankAccount.accountName.
  guestName            String?
  /// Hex HMAC-SHA256 of the trimmed, lowercased guest email under FIELD_HMAC_KEY.
  /// Searchable, so a Guest Donor can be matched to their own giving history.
  guestEmailHmac       String?
  guestEmailHmacKeyId  String?
  /// base64(iv | AES-256-GCM ciphertext | tag) of the guest email under FIELD_ENCRYPTION_KEY.
  guestEmailCiphertext String?
  guestEmailKeyId      String?
  /// Never searched, so ciphertext only: no HMAC, same as User.phone.
  guestPhoneCiphertext String?
  guestPhoneKeyId      String?

  /// The `src` a shared link carried when the Donor arrived, sanitized by
  /// src/lib/traffic-source.ts (ticket 24, "Traffic Source on Donation").
  /// Null when absent or when nothing safe survived sanitizing -- this never
  /// blocks a Donation.
  trafficSource String? @db.VarChar(40)

  /// Whether the Wakif ticked the ikrar confirmation at checkout (CONTEXT.md,
  /// Akad Wakaf; PRD user story 17: "confirm the ikrar by checkbox ... so
  /// that the pledge is explicit rather than assumed"). Meaningless and left
  /// false on every non-`wakaf` Donation; POST /api/donations refuses a
  /// `wakaf` Donation where this is not explicitly true, so it can never be
  /// an assumed default for the Kind that requires it.
  ikrarConfirmed Boolean @default(false)

  // Relations
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  donor    User?    @relation(fields: [donorId], references: [id], onDelete: SetNull)
  prayer   Prayer?

  /// A retry creates a NEW Payment on the SAME Donation rather than mutating
  /// or replacing the old one (prd-compliance 18), so this is a list, not
  /// Payment?: history of every attempt survives, and at most one may ever
  /// reach PAID -- enforced by a partial unique index in the migration
  /// (Payment_donationId_paid_key), not by this relation's shape.
  payments  Payment[]
  /// Created once, the moment this Donation's Payment settles (prd-compliance
  /// 21) -- never before, since there is nothing to receipt until then.
  receipt   Receipt?
  /// Created alongside the Receipt, only for a Donation on a `wakaf`
  /// Campaign (CONTEXT.md, Akad Wakaf; ticket 22).
  akadWakaf AkadWakaf?

  /// Set once, the moment this Donation settles above the single-Donation
  /// review threshold, and read by nobody but the Admin's scrutiny view
  /// (prd-compliance 38). It marks the Donation; it does not change it.
  reviewMarker DonationReviewMarker?

  @@index([campaignId])
  @@index([donorId])
  @@index([paymentStatus])
  @@index([guestEmailHmac])
  @@index([createdAt])
}

/// The Donor's proof of a Donation (CONTEXT.md, Receipt), created once a
/// Donation Settles. `token` names the print page to a Donor who may have no
/// account (a Guest Donor) -- unguessable on purpose, since it is the only
/// thing standing between the page and anyone who finds the link, so it is
/// never derived from the Donation id or any other guessable value.
model Receipt {
  id          String    @id @default(cuid())
  donationId  String    @unique
  token       String    @unique
  /// When the Settlement email was (last) attempted -- fires once at
  /// Settlement, when both are set equal; a resend advances lastSentAt (and
  /// resendCount) alone. Nullable only so a future writer that must create a
  /// Receipt ahead of sending it is not forced to lie about when.
  sentAt      DateTime?
  lastSentAt  DateTime?
  resendCount Int       @default(0)
  createdAt   DateTime  @default(now())

  // Relations
  donation Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)
}

/// The Wakif's pledge document per Donation on a `wakaf` Campaign
/// (CONTEXT.md, Akad Wakaf; ADR 0010; ticket 22), created once, alongside
/// the Receipt, the moment that Donation's Payment settles -- never before,
/// same reasoning as Receipt. Names the Wakif, the amount, the purpose and
/// the nazhir; none of those are columns here because every one of them is
/// read off the Donation/Campaign/Collecting Entity at render time, exactly
/// like Receipt does, so there is nothing here to fall out of sync with them.
///
/// `token` gates its print page the same way Receipt's does: unguessable,
/// never derived from the Donation id, since a Guest Donor (Wakif with no
/// account) has no session to gate it with instead.
model AkadWakaf {
  id         String   @id @default(cuid())
  donationId String   @unique
  token      String   @unique
  createdAt  DateTime @default(now())

  // Relations
  donation Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)
}

// ==================== Prayer ====================

model Prayer {
  id         String   @id @default(cuid())
  text       String   @db.VarChar(500)
  amiinCount Int      @default(0)
  donationId String   @unique
  campaignId String
  userId     String?
  createdAt  DateTime @default(now())

  // Relations
  donation Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([createdAt])
  @@index([userId])
}

// ==================== Campaign Update ====================

model CampaignUpdate {
  id         String   @id @default(cuid())
  title      String
  content    String   @db.Text
  images     String[]
  campaignId String
  createdAt  DateTime @default(now())

  // Relations
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([createdAt])
}

// ==================== Notification ====================

model Notification {
  id        String   @id @default(cuid())
  type      String // "donation_confirmed" | "campaign_update" | "disbursement"
  title     String
  message   String
  isRead    Boolean  @default(false)
  userId    String
  link      String?
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
}

// ==================== Auto Donation ====================

model AutoDonation {
  id        String   @id @default(cuid())
  amount    Int
  category  String
  schedule  String // "daily" | "weekly"
  time      String // "HH:mm" format
  isActive  Boolean  @default(true)
  userId    String
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

// ==================== Category ====================

model Category {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  icon  String
  order Int    @default(0)

  @@index([slug])
  @@index([order])
}

// ==================== Money ====================
//
// Everything below is the money layer. It did not exist: donations carried a
// free-text `paymentStatus` that an unauthenticated endpoint could set, there
// was no record of a provider charge, no refunds, no bank accounts, no payout
// approval, and no ledger. A platform in that state can display totals but
// cannot answer "where is the money", which is the only question that matters
// when someone asks.
//
// THREE RULES THIS SECTION IS BUILT ON
//
// 1. Amounts are Int rupiah, matching Donation.amount and Campaign.targetAmount
//    already in this schema. IDR has no circulating minor unit, so there is no
//    cents problem to solve, and Int avoids float entirely. Never introduce a
//    Float for money here.
//
// 2. Status is an enum, never a String. The free-text paymentStatus is what let
//    "confirmed", "pending" and anything else coexist with no constraint; the
//    database should refuse an invalid state, not hope callers behave.
//
// 3. The ledger is double-entry and append-only. Balances are derived by
//    summing entries, never stored as a mutable column. Campaign.collectedAmount
//    stays as a denormalised display figure, but it stops being the source of
//    truth -- LedgerEntry is.

enum PaymentStatus {
  PENDING // created at the provider, awaiting the payer
  PAID // provider confirmed settlement
  EXPIRED // payment window closed unpaid
  FAILED // provider rejected it
  REFUNDED // fully refunded; partial refunds stay PAID with Refund rows
}

enum RefundStatus {
  REQUESTED
  AWAITING_DONOR_DETAILS
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  FAILED
}

enum PayoutStatus {
  // A payout is money leaving the platform, so it gets an explicit approval
  // step that cannot be skipped by a status write.
  DRAFT // campaigner is filling it in
  SUBMITTED // awaiting review
  APPROVED // reviewed, not yet sent
  REJECTED
  PROCESSING // instructed to the bank
  COMPLETED // funds confirmed out
  FAILED
}

enum LedgerAccount {
  // Named accounts rather than free strings, so a typo cannot silently create
  // a new account that never balances.
  ESCROW_HOLD // settled at the provider, still inside the dispute window
  CAMPAIGN_BALANCE // owed to a specific campaign, withdrawable now
  TRIP_BALANCE
  /// CSR money recorded against a Program (CONTEXT.md, Program Balance;
  /// Manual Contribution). Withdrawable by no Payout, ever: a Program is not
  /// a Campaign, Payout has no Program column, and nothing in this codebase
  /// can set one -- asserted in manual-contribution-isolation.test.ts.
  PROGRAM_BALANCE
  /// Money moved out of ESCROW_HOLD or the withdrawable balance the moment a
  /// Refund is created -- no longer visible as available, no longer eligible
  /// for a Payout, remaining the Donor's right until the (out-of-scope for
  /// this ticket) COMPLETED transition. See CONTEXT.md's "Frozen Balance".
  FROZEN_BALANCE
  PLATFORM_FEE // retained by the platform
  PROVIDER_FEE // retained by the payment provider
  /// CONTEXT.md's Provider Balance: the Donors' money sitting at the payment
  /// provider under the Merchant Account, debited with the full Gross of
  /// every settlement. Debit-normal -- it grows when money arrives and shrinks
  /// when money physically leaves the provider. The balance it SHOULD hold is
  /// the money still sitting there that the Campaign, the platform and the
  /// provider are owed between them, and nothing else (ADR 0011).
  ///
  /// THREE MOVEMENTS CREDIT IT, and none of them may be skipped when reading
  /// what a balance here means:
  ///
  ///   - a Payout completed by the second Admin (payoutCompletedLegs,
  ///     prd-compliance 27, PR #73) -- the money went to the Fundraiser;
  ///   - a Refund actually paid to the Donor (refundPaidLegs, prd-compliance
  ///     28c, PR #83) -- BUILT BUT NOT YET POSTED: it has no production caller,
  ///     because the COMPLETED transition that would call it is ticket 32, so
  ///     nothing reaches this account that way today;
  ///   - a withdrawal to the Collection Account
  ///     (collectionAccountWithdrawalLegs, prd-compliance 35) -- THIS ONE IS IN
  ///     THE CODE, and it does post: the money went to the bank, which is the
  ///     third and last path out of the pot.
  ///
  /// Of those three, only the third names the provider it drew on
  /// (LedgerEntry.provider), so a per-provider reading of this account is a
  /// FLOOR rather than the whole pot for as long as a Payout can be completed
  /// without recording which provider paid it. See
  /// src/lib/money/ledger.ts's providerBalances, which reports the unnamed
  /// remainder as its own bucket rather than folding it into a named one.
  GATEWAY_CLEARING
  /// CONTEXT.md's Collection Account: the rekening penghimpunan the money is
  /// swept to from the Merchant Account, and a DIFFERENT THING from it
  /// (ADR 0011).
  ///
  /// DEBIT-NORMAL, and the sweep is the whole reason: the recorded withdrawal
  /// DEBITS this account (collectionAccountWithdrawalLegs,
  /// src/lib/money/ledger.ts), so the balance is read debits - credits -- the
  /// same convention as the Provider Balance a settlement debits, and the one
  /// collectionAccountBalance uses. Read credit-normal it would print 0 for a
  /// million rupiah that had just reached a bank. That is the only direction
  /// this account is read in, and no sentence here describes a second one.
  ///
  /// No Payout appears here, and that is the shape of the flow rather than a
  /// modelling oversight: a Payout is paid out of the Provider Balance by hand
  /// in the provider's dashboard (ADR 0006) and never reaches a bank balance.
  /// Which is also why this account's balance is the honest answer to "how much
  /// of the Donors' money has reached a bank" (prd-compliance 35).
  ///
  /// Platform-level, carrying no subject id: the Collection Account is the
  /// platform's or the Collecting Entity's bank account, not a Campaign's.
  /// Which entity owns the account is recorded on the ProviderWithdrawal row
  /// that posted here, not on the entry, because one account can receive from
  /// more than one withdrawal and the answer changes per withdrawal.
  COLLECTION_ACCOUNT
  PAYOUT_CLEARING // money instructed out, not yet confirmed
  /// The Donor's own claim once a Refund is approved, and the money the
  /// platform owes that Donor until the transfer lands: credited the full
  /// Gross at approval, debited when the Donor is actually paid
  /// (refundPaidLegs). Every returned fee rides out of here rather than
  /// staying behind in the Provider Balance, so nothing a Refund hands back
  /// is left claimed as money owed to the platform or the provider.
  REFUND_CLEARING
  /// Money that arrived outside the payment gateway -- a bank transfer or cash
  /// handed over -- and is not yet attributed to a Campaign or a Program. The
  /// other side of a Manual Contribution, and the account the money returns to
  /// when that contribution is reversed. Platform-level on purpose: until a
  /// contribution names its target, the money belongs to nobody in particular,
  /// which is exactly why it cannot be read as any subject's balance.
  MANUAL_INTAKE_CLEARING
  /// The platform's absorption of whatever a Refund's source didn't cover --
  /// the unrecoverable Provider Fee on every Gross refund (ADR 0007), and,
  /// when the subject's pool has gone negative, the uncovered shortfall too.
  /// Debit-normal, and an expense rather than a pot: the balance is what the
  /// platform has spent carrying Refunds, and it is the account that keeps
  /// that difference named instead of silently absorbed.
  REFUND_COST
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

/// A charge attempt at a payment provider. One Donation has at most one
/// Payment; a retry creates a NEW Payment rather than mutating the old one, so
/// the history of attempts survives.
model Payment {
  id             String        @id @default(cuid())
  /// Not unique: a retry after FAILED/EXPIRED creates a new Payment on the
  /// same Donation (prd-compliance 18). At most one Payment per Donation may
  /// ever reach PAID -- enforced in the migration by a partial unique index
  /// (`WHERE status = 'PAID'`), the database's own guarantee against two
  /// distinct webhook deliveries settling two different Payments of the same
  /// Donation, races the app-level `status: PENDING` guard alone cannot
  /// close.
  donationId     String?
  donation       Donation?     @relation(fields: [donationId], references: [id], onDelete: Restrict)
  /// Set instead of donationId for a Trip Fee payment -- exactly one of the
  /// two is ever set, enforced by assertExactlyOnePaymentSubject
  /// (./src/lib/money/payment-subject.ts), not by a schema constraint
  /// Prisma cannot express. onDelete: Restrict, matching donationId's own
  /// pinning -- a fresh optional relation defaults to Prisma's implicit
  /// SetNull otherwise, the exact class of bug a whole-branch review on an
  /// earlier ticket caught for donationId/campaignId. Applied here
  /// proactively.
  registrationId String?       @unique
  registration   Registration? @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  /// The Payment Provider this charge went through, in the name that appears
  /// in its webhook URL, on this row and on the WebhookEvent for the same
  /// delivery -- one spelling per provider so the Provider Balance, which is
  /// split by exact string equality, cannot end up with two pots for one
  /// provider (ADR 0006).
  ///
  /// A registered name, and the registered names are exactly "mock" |
  /// "sumopod" -- PAYMENT_PROVIDER_NAMES in
  /// src/lib/payments/provider-names.ts. Nothing else is a provider name in
  /// this build: a Midtrans or Xendit adapter does not exist yet, so naming
  /// one here would write a value no code can settle against.
  ///
  /// A plain String rather than an enum because that registry already is the
  /// enum, and the schema deliberately does not keep a second copy of it: an
  /// enum here would list the same names again, in this file and in the
  /// generated client, while the gate every write already passes is
  /// canonicalPaymentProviderName (./src/lib/payments/provider-names.ts), not
  /// the column's type. Switching providers on from the Admin dashboard is
  /// therefore a new name in that registry plus a builder in
  /// src/lib/payments/index.ts, and nothing in this file.
  provider       String
  /// Which method the provider charged through, in its own vocabulary rather
  /// than the donor's choice: PaymentMethod in src/lib/payments/types.ts,
  /// "bank_transfer_va" | "qris_redirect". The donor-facing choices
  /// ("bank_transfer", "qris", "ewallet", "credit_card") are mapped onto
  /// those -- or onto nothing, for the two no adapter implements -- by
  /// PROVIDER_METHOD_FOR in src/lib/money/payment-method-map.ts, before the
  /// Payment is written, and never after.
  method         String
  /// The provider's own id for this charge. Unique so a webhook replay cannot
  /// create a second Payment for the same upstream charge.
  providerRef    String        @unique
  amount         Int
  /// What the provider kept. Recorded separately so the campaign is credited
  /// the net, and the fee is visible rather than silently missing.
  providerFee    Int           @default(0)
  /// What the platform kept (CONTEXT.md, Platform Fee; prd-compliance 17).
  /// Resolved and frozen at POST /api/donations, per Campaign then per
  /// Category then per Kind default, waived below the Admin-set threshold,
  /// rounded down -- never recomputed at Settlement, so a later change to
  /// the rate cannot alter what this Payment already promised the Donor.
  /// Always 0 for a Trip Fee Payment (registrationId set): Trip Fee is not
  /// subject to Platform Fee (CONTEXT.md, Trip Fee).
  platformFee    Int           @default(0)
  status         PaymentStatus @default(PENDING)
  /// Provider payload, kept verbatim for dispute resolution. Never parsed for
  /// business logic -- the typed columns above are what the app reads.
  rawPayload     Json?
  paidAt         DateTime?
  /// The provider's own settlement estimate for this Payment, read from its
  /// webhook payload (docs/integrasi-sumopod.md, "Waktu dan Escrow";
  /// prd-compliance 19) -- NOT proof the money has actually arrived, since
  /// none of the providers this repo speaks to expose a balance API to
  /// confirm that. escrowReleaseAt below is computed from this, never from
  /// paidAt or server receipt time: anchoring to receipt time would let a
  /// slow-settling provider's Escrow Hold lapse before the money has
  /// actually cleared. Null while unpaid, same as paidAt.
  settledAt      DateTime?
  expiresAt      DateTime?

  /// The Escrow Hold length (CONTEXT.md, Escrow Hold), frozen from
  /// ESCROW_HOLD_DAYS (src/lib/money/escrow.ts) at Payment creation and shown
  /// to the Donor before they pay (prd-compliance 18). Read at Settlement
  /// instead of the live constant, so an Admin shortening or lengthening the
  /// default afterwards cannot move a Payment already created under the old
  /// one. Always the value in force when THIS Payment was created, never
  /// recomputed.
  escrowHoldDays Int @default(7)

  /// When this payment's money stops being escrow and becomes withdrawable.
  /// Set on settlement to settledAt + the hold period (prd-compliance 19);
  /// null while unpaid.
  ///
  /// The hold exists so a refund or a dispute has somewhere to land. Without
  /// it, a donation can be paid out to the campaigner before the donor's bank
  /// has finished deciding whether the charge was theirs, and the platform is
  /// then chasing money it has already sent away.
  escrowReleaseAt  DateTime?
  /// Stamped when the release entries are actually posted. Together with the
  /// field above this is the sweep's whole state: due is `escrowReleaseAt <=
  /// now AND escrowReleasedAt IS NULL`, which is also why they share an index.
  escrowReleasedAt DateTime?

  /// Ticket 15. Stamped with the sweep's `now` whenever releaseMaturedEscrow
  /// (src/lib/money/escrow.ts) skips this Payment because a PERMANENT guard
  /// holds it -- isEscrowReleaseFrozen (a SUSPENDED subject) or an in-flight
  /// Refund -- never for a Payment that simply has not matured yet, and
  /// never touched by the claim itself (updateMany only ever writes
  /// escrowReleasedAt). Cleared back to null the moment a later sweep
  /// finally releases this Payment, so a row that WAS stuck and later
  /// resolved reads identically to one that was never stuck at all.
  ///
  /// Exists only to give the sweep's query a secondary sort key that moves
  /// with each skip, because escrowReleaseAt deliberately does not: changing
  /// escrowReleaseAt to push a stuck row back would be an accounting error
  /// (CONTEXT.md, Escrow Hold -- it is the hold's own maturity date, not a
  /// scheduling hint). Ordering `escrowSweepDeferredAt ASC NULLS FIRST,
  /// escrowReleaseAt ASC, id ASC` puts every never-skipped row (the common
  /// case) ahead of every previously-skipped one, and rotates previously-skipped
  /// rows oldest-skipped-first among themselves -- so a backlog of
  /// permanently-stuck rows, however large, can never again fill every
  /// future call's page and starve the genuinely releasable rows behind it.
  escrowSweepDeferredAt DateTime?

  /// Ticket 43: when the stuck-late-settlement-refund sweep
  /// (src/lib/volunteer/refund-sweep.ts) last FAILED to refund this Trip Fee
  /// Payment. Only a sort key: the sweep orders `refundSweepFailedAt ASC NULLS
  /// FIRST`, so a Registration that keeps failing rotates behind never-failed
  /// ones and cannot fill every round's limit. Null for every Payment that
  /// has never failed; never read for any money decision.
  refundSweepFailedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refunds       Refund[]
  ledgerEntries LedgerEntry[]

  @@index([status])
  @@index([provider, status])
  @@index([donationId, status])
  @@index([escrowReleaseAt, escrowReleasedAt])
  /// The sweep's own paging order (ticket 15): releaseMaturedEscrow orders
  /// candidates `escrowSweepDeferredAt ASC NULLS FIRST, escrowReleaseAt ASC,
  /// id ASC`, and this index carries the same column order so that ordering
  /// is served by an index scan rather than a sort over the whole matched
  /// set.
  @@index([escrowSweepDeferredAt, escrowReleaseAt, id])
}

enum PlatformFeeScope {
  KIND
  CATEGORY
  CAMPAIGN
}

/// One Admin-set Platform Fee rate (CONTEXT.md, Platform Fee; prd-compliance
/// 17). Append-only: setting a new rate for a scope+key inserts a row rather
/// than mutating one, so "who and when" a rate changed is exactly
/// setById/setAt on that row and no separate audit table is needed. The row
/// with the latest setAt for a given scope+key is the one in force
/// (resolvePlatformFeeBasis, src/lib/money/platform-fee-config.ts); earlier
/// rows are left alone, both as history and because a Payment created under
/// them already froze its own platformFee and never re-reads this table.
model PlatformFeeRule {
  id         String           @id @default(cuid())
  scope      PlatformFeeScope
  /// Set only when scope = KIND.
  kind       Kind?
  /// Set only when scope = CATEGORY -- Campaign.category's free-text value.
  category   String?
  /// Set only when scope = CAMPAIGN.
  campaignId String?
  /// Percent in basis points (1/100 of a percent), an integer so no rate
  /// ever needs a float: 250 = 2.5%.
  percentBps Int
  setById    String
  setAt      DateTime         @default(now())

  // Relations
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  setBy    User      @relation(fields: [setById], references: [id], onDelete: Restrict)

  @@index([scope, kind, setAt])
  @@index([scope, category, setAt])
  @@index([scope, campaignId, setAt])
}

/// The Admin-set nominal below which Platform Fee is waived entirely, so a
/// small gift carries only the Provider Fee (CONTEXT.md, Platform Fee;
/// prd-compliance 17). Same append-only pattern as PlatformFeeRule: the row
/// with the latest setAt is in force.
model PlatformFeeThreshold {
  id      String   @id @default(cuid())
  amount  Int
  setById String
  setAt   DateTime @default(now())

  setBy User @relation(fields: [setById], references: [id], onDelete: Restrict)

  @@index([setAt])
}

/// The title similarity above which two Campaigns count as alike, as an
/// Admin sets it (PRD FFI-05: "ambang 0,6 diatur Admin"; prd-compliance 14).
/// The same append-only pattern as PlatformFeeThreshold: the row with the
/// latest setAt is in force, and setById/setAt on it are the "who and when".
/// No row is seeded, so with none set the threshold is the PRD's 0.6, read
/// from code the way an unset Platform Fee resolves to 0 bps
/// (resolveDuplicateSimilarityThreshold, src/lib/duplicate-hints.ts).
model DuplicateSimilarityThreshold {
  id        String   @id @default(cuid())
  /// A `similarity()` score from pg_trgm: above 0, at most 1, not a percent.
  threshold Float
  setById   String
  setAt     DateTime @default(now())

  setBy User @relation(fields: [setById], references: [id], onDelete: Restrict)

  @@index([setAt])
}

/// The four money-and-volume limits the platform watches itself against
/// (PRD §"Anti penyalahgunaan"; CONTEXT.md, Verifikasi Tambahan, Penanda
/// Audit, Penanda Donasi; prd-compliance 38).
///
/// A separate table from DuplicateSimilarityThreshold on purpose, though the
/// pattern is the same one: both are Admin settings an append-only history
/// answers, but that threshold is a trigram score compared between two
/// Campaigns at review time, and these are rupiah amounts and a Campaign
/// count compared against money that has actually arrived. One place per
/// question, never one place per Admin who typed a number.
enum AbuseThresholdKind {
  /// Cumulative Gross on one Campaign above which a Verifier reviews it again.
  CAMPAIGN_REVIEW_GROSS
  /// Cumulative Gross on one Campaign above which the Campaign carries an audit marker.
  CAMPAIGN_AUDIT_GROSS
  /// One Donation above which an Admin is pointed at it. Never blocks it.
  DONATION_REVIEW_AMOUNT
  /// How many Active Campaigns one Fundraiser may run before their first Usage Report.
  ACTIVE_CAMPAIGNS_PER_FUNDRAISER
}

/// One threshold in force, as an Admin set it: the row with the latest setAt
/// for a kind is the current value, and setById/setAt on it are the "who and
/// when". Nothing is seeded, so with no row set the PRD's own numbers apply,
/// read from code (resolveAbuseThresholds, src/lib/abuse-thresholds.ts) the
/// way an unset Platform Fee resolves to 0 bps.
model AbuseThreshold {
  id      String             @id @default(cuid())
  kind    AbuseThresholdKind
  /// Rupiah for the three money limits, a plain count for
  /// ACTIVE_CAMPAIGNS_PER_FUNDRAISER. Int, like every amount in this schema.
  value   Int
  setById String
  setAt   DateTime           @default(now())

  setBy User @relation(fields: [setById], references: [id], onDelete: Restrict)

  @@index([kind, setAt])
}

/// The audit marker a Campaign carries once its Cumulative Gross has passed
/// the audit threshold (CONTEXT.md, Penanda Audit). One row per Campaign --
/// the unique campaignId is what makes a second settlement above the
/// threshold a no-op rather than a second marker -- carrying the Gross and the
/// threshold in force at the moment it was placed, so the marker says why it
/// is there without re-deriving anything.
///
/// A marker, not a decision: it changes no status, blocks no Donation and
/// nobody is asked to do anything by it being written. It is the record that
/// the platform noticed the size of a Campaign, which an audit reads later.
model CampaignAuditMarker {
  id              String   @id @default(cuid())
  campaignId      String   @unique
  cumulativeGross Int
  threshold       Int
  placedAt        DateTime @default(now())

  // Relations
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
}

/// One Donation above the single-Donation threshold, pointed at for an Admin
/// (CONTEXT.md, Penanda Donasi). One row per Donation, by the same unique
/// donationId argument as the audit marker: the Donation is the thing being
/// looked at, so a retried settlement must not turn it into several.
///
/// Nothing is blocked and no status moves. The Donation settled, the money is
/// in the books, and an Admin is told it is unusual -- which is the whole
/// point: the alternative, refusing the money, is what loses the platform the
/// evidence.
model DonationReviewMarker {
  id         String   @id @default(cuid())
  donationId String   @unique
  campaignId String
  amount     Int
  threshold  Int
  flaggedAt  DateTime @default(now())

  // Relations
  donation Donation @relation(fields: [donationId], references: [id], onDelete: Restrict)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  @@index([campaignId, flaggedAt])
}

/// Every webhook the platform has accepted, by provider event id.
///
/// Exists solely so a replayed or duplicated webhook is a no-op. Providers
/// retry aggressively and do not promise exactly-once delivery; without this,
/// a retry credits the campaign twice.
model WebhookEvent {
  id              String    @id @default(cuid())
  provider        String
  /// The provider's event id. The unique constraint IS the idempotency
  /// mechanism -- the insert fails on a replay, and the handler returns 200
  /// without touching anything else.
  providerEventId String
  payload         Json
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?

  @@unique([provider, providerEventId])
  @@index([provider, receivedAt])
}

model Refund {
  id            String       @id @default(cuid())
  paymentId     String
  payment       Payment      @relation(fields: [paymentId], references: [id])
  /// Partial refunds are allowed, so this is not necessarily the full payment.
  amount        Int
  reason        String
  status        RefundStatus @default(REQUESTED)
  requestedById String
  requestedBy   User         @relation("RefundRequester", fields: [requestedById], references: [id])
  /// Who approved it. Refunds move money back out, so they are attributable.
  approvedById  String?
  approvedBy    User?        @relation("RefundApprover", fields: [approvedById], references: [id])
  providerRef   String?      @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  /// The third Admin: completes an APPROVED Refund by recording that the
  /// Admin has transferred the money by hand to the Donor's account
  /// (CONTEXT.md, Refund; PRD §7.2; ticket 31). Two-person rule's second
  /// half, enforced in the service layer exactly like Payout.completedById --
  /// this Admin must be neither requestedBy nor approvedBy -- and the column
  /// exists so it is auditable after the fact.
  completedById String?
  completedBy   User?     @relation("RefundCompleter", fields: [completedById], references: [id])
  completedAt   DateTime?
  /// Ticket 13's proof-of-transfer shape (transaction reference + free
  /// sentence), joined into one string by the same `buildProofImage`
  /// Payout.proofImage already uses (@/lib/payout-proof) -- one validator,
  /// now three callers (Payout, and this).
  proofImage    String?

  /// The Donor's destination account, recorded by the approving Admin from
  /// the Donor's written request -- there is no saved BankAccount row for a
  /// Donor (ADR 0018, Amendment 2026-09-28). The completing Admin re-types
  /// the number and the server compares it before any money moves. Nullable
  /// because every Refund approved before ticket 31 has none.
  donorBankCode                String?
  /// Plaintext, like BankAccount.accountName: compared against the name on
  /// the Donation (ADR 0012's stated reason for leaving that field alone).
  donorAccountName             String?
  /// Sealed with the same field encryption as BankAccount.accountNumber
  /// (ADR 0012; @/lib/contact-fields.ts) -- a randomized AES-256-GCM
  /// ciphertext, never searched, and never rendered back in full. Bound to
  /// its own AAD ("Refund.donorAccountNumber"), not BankAccount's, so a
  /// ciphertext copied from one column to the other fails to decrypt rather
  /// than silently reading as the wrong donor's number.
  donorAccountNumberCiphertext String?
  donorAccountNumberKeyId      String?

  ledgerEntries LedgerEntry[]

  @@index([status])
  @@index([paymentId])
}

/// Where a campaign's money is sent. Separate from the campaign so the account
/// can be verified once and reused, and so changing it is an auditable event
/// rather than an edit to the campaign row.
model BankAccount {
  id                      String    @id @default(cuid())
  ownerId                 String
  owner                   User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bankCode                String
  /// ADR 0012 contract step (prd-compliance 16): a randomized AES-256-GCM of
  /// the account number, and the only form stored. This is a payout
  /// destination, not a card number, and it is still read in full to instruct
  /// the transfer -- decrypted at the point of payout, with masking at the UI.
  /// Never searched, so there is no HMAC for it, same as User.phone.
  accountNumberCiphertext String
  accountNumberKeyId      String
  /// Plaintext by decision (ADR 0012): Refund compares the holder name against
  /// the name on the Donation, which is impossible on a ciphertext.
  accountName             String
  /// Set only once the name has been checked against the bank's records.
  /// Payouts must refuse an unverified destination.
  verifiedAt              DateTime?
  createdAt               DateTime  @default(now())

  payouts              Payout[]
  verificationRequests BankAccountVerificationRequest[]
  revocations          BankAccountRevocation[]

  // What used to be `@@unique([ownerId, bankCode, accountNumber])` cannot
  // survive the drop: the account number is a randomized ciphertext, and two
  // encryptions of one number never match, so the constraint could never fire.
  // Nothing replaces it. The database does not refuse a duplicate and no
  // application code checks for one, so a Fundraiser may end up holding two
  // Bank Accounts with the same number and nothing will say so. Restoring a
  // guarantee needs a keyed lookup for the account number, which ADR 0012
  // deliberately does not have: it is never searched. CONTEXT.md records this
  // under Bank Account, and whether that is acceptable for a payout
  // destination is the owner's call.
  @@index([ownerId])
}

/// One submission of a BankAccount to a Verifier (ticket 16, decisions 1, 2
/// and 4; ADR 0018). A separate table, not VerificationRequest with a
/// nullable campaignId: a BankAccount belongs to a User, who has no Campaign,
/// and VerificationRequest.campaignId is required with onDelete: Restrict.
/// Piggybacks on the same SUBMITTED/PENDING queue discipline and the same
/// two-person rule as a Campaign's Verification Request and a Volunteer
/// Trip's moderation, per ADR 0018's decision (though not its stated reason,
/// which the ticket reverses: see the ticket file for why).
///
/// checkedBankCode and documentedAccountName are what the Verifier read off
/// the document (decisions 1 and 2): both required to APPROVE, both null on
/// a REJECTED row. "Rekening sesuai" is deliberately not a
/// VerificationChecklistItem.kind value -- that enum is a template of
/// campaign documents, and a bank account name/code check is not one.
///
/// note carries a REJECT's reason as well as an APPROVE's optional note: the
/// model has one free-text column, not two, so a rejection's required reason
/// is written into `note` rather than into a column this table does not have.
///
/// verifiedAt on BankAccount is written only by approving this request
/// (ticket 16), never here, never by submitting one. No uniqueness is
/// promised or invented on BankAccount.accountNumberCiphertext (see its own
/// comment); this table does not change that.
model BankAccountVerificationRequest {
  id                    String              @id @default(cuid())
  bankAccountId         String
  bankAccount           BankAccount         @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  outcome               VerificationOutcome @default(PENDING)
  checkedBankCode       String?
  documentedAccountName String?
  note                  String?
  submittedById         String
  submittedBy           User                @relation("BankAccountVerificationSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  submittedAt           DateTime            @default(now())
  /// The Verifier who approved or rejected, or the owner who withdrew their
  /// own PENDING request (the same "who closed it" shape
  /// VerificationRequest.decidedById uses for a Fundraiser's withdrawal).
  decidedById           String?
  decidedBy             User?               @relation("BankAccountVerificationDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  decidedAt             DateTime?

  /// The Verifier queue: oldest PENDING first.
  @@index([outcome, submittedAt])
  /// One account's own history.
  @@index([bankAccountId, submittedAt])
}

/// REVOKED clears BankAccount.verifiedAt; REINSTATED sets it again. A
/// separate action from Suspension (ticket 11's answer): clearing a Bank
/// Account's eligibility is not a judgement about a Campaign, and this row
/// carries no CampaignStatusChangeAction.
enum BankAccountRevocationAction {
  REVOKED
  REINSTATED
}

/// One row per revoke or reinstate of a Bank Account's `verifiedAt`
/// (ticket 11; owner decision 2026-09-28, on top of ADR 0018). Same pattern
/// as CampaignStatusChange for Suspension: an append-only action log, not a
/// status column, so "was this ever revoked, and by whom" is answered by
/// reading history rather than trusting a flag. The account's current state
/// is `BankAccount.verifiedAt` itself (null = ineligible, whether never
/// verified or revoked; set = eligible) -- this table is the "why" and
/// "who", not a second source of the "whether".
///
/// Both halves are their own action, not Suspension's cousin: revoking an
/// account's verification is not the same decision as suspending the
/// Campaign a Payout was headed for, and doing one never does the other
/// (ticket 11's answer, (b)). Payouts already paid are untouched by either
/// action -- this table never reaches into Payout or the ledger, and
/// `payouts.ts`'s existing `BankAccountNotEligibleError` checks (requestPayout,
/// approvePayout, completePayout all re-read `verifiedAt` fresh) are what
/// stop an unpaid Payout once `verifiedAt` is cleared.
///
/// `actorId` is the deciding Verifier for both actions -- never the account's
/// owner (ADR 0018's "never a Verifier on their own account", checked in the
/// command) and never, for a REVOKED row, the Verifier who most recently
/// approved the account's verification, and never, for a REINSTATED row, the
/// Verifier who wrote the REVOKED row it reverses. `reason` is required on
/// both: a cleared or restored `verifiedAt` with no trace is the thing ADR
/// 0018 already refuses for the original verification.
model BankAccountRevocation {
  id            String                      @id @default(cuid())
  bankAccountId String
  bankAccount   BankAccount                 @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  action        BankAccountRevocationAction
  reason        String
  actorId       String
  actor         User                        @relation("BankAccountRevocationActor", fields: [actorId], references: [id], onDelete: Restrict)
  createdAt     DateTime                    @default(now())

  /// One account's own revoke/reinstate history, latest first.
  @@index([bankAccountId, createdAt])
}

/// Money leaving the platform to a campaign's bank account.
///
/// Replaces the previous Disbursement model, which had no status, no approver,
/// and no destination -- it recorded that a payout had supposedly happened
/// without any of the facts that make it checkable.
/// Money that arrived outside the payment gateway (CONTEXT.md, Manual
/// Contribution; PRD FFI-07c): a bank transfer, or cash handed over.
///
/// Two people, the same rule as a Payout. One Admin records it with the proof
/// of transfer; a DIFFERENT Admin approves it, and only then does the money
/// enter the books -- credited straight to the Campaign Balance, or to the
/// Program Balance when it names a Program, with no Escrow Hold and neither
/// fee, because none of that machinery describes money that never went near
/// a provider.
///
/// `status` is the whole lifecycle, and no step deletes anything: a
/// correction is a REVERSAL, a new balanced transaction that posts the mirror
/// image of the credit, and the original rows stay where they are.
///
/// onDelete: Restrict on every relation of this table, like Payout and
/// CampaignStatusChange: neither deleting the Campaign, the Program, nor the
/// people involved may erase who recorded, who approved, or how much. The
/// back-reference on LedgerEntry is the exception, onDelete: SetNull, because a
/// ledger entry is the immutable record of the money and outlives the row it
/// points at.
model ManualContribution {
  id             String    @id @default(cuid())
  amount         Int
  /// Exactly one of campaignId/programId is set, guarded in the service
  /// layer (assertExactlyOneManualContributionSubject,
  /// src/lib/money/manual-contributions.ts) because Prisma cannot express a
  /// conditional requirement on two nullable columns.
  campaignId     String?
  campaign       Campaign? @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  programId      String?
  program        Program?  @relation(fields: [programId], references: [id], onDelete: Restrict)
  /// The proof of transfer: a receipt image, a bank statement line, whatever
  /// the Admin can point at. Required, not nullable -- an Admin recording
  /// money on a word of mouth is exactly what the two-person rule is there to
  /// catch, and a later column would not be evidence of anything.
  proofReference String    @db.VarChar(500)
  /// Free text: who handed it over, which bank, what for.
  note           String?

  status         ManualContributionStatus @default(PENDING)
  recordedById   String
  recordedBy     User                     @relation("ManualContributionRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  /// Two-person rule: never recordedById. The columns exist so the rule is
  /// auditable after the fact, exactly as on Payout; the check is in the
  /// service layer.
  decidedById    String?
  decidedBy      User?                    @relation("ManualContributionDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  decidedAt      DateTime?
  decisionReason String?
  /// Two-person rule, second half: never recordedById and never decidedById.
  /// A reversal the pair that put the money in could do itself would make the
  /// whole rule revocable by one person, so a THIRD Admin takes it back out.
  /// The check is in the service layer, like the one above.
  reversedById   String?
  reversedBy     User?                    @relation("ManualContributionReverser", fields: [reversedById], references: [id], onDelete: Restrict)
  reversedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledgerEntries LedgerEntry[]

  @@index([campaignId, status])
  @@index([programId, status])
  @@index([status, createdAt])
}

/// PENDING until a second Admin decides. APPROVED: the money is in the
/// balance. REJECTED: the second Admin declined, and nothing was ever posted
/// -- a decision, not a deletion, so the record and the proof survive.
/// REVERSED: the money has been taken back out by an opposite journal.
enum ManualContributionStatus {
  PENDING
  APPROVED
  REJECTED
  REVERSED
}

model Payout {
  id              String       @id @default(cuid())
  campaignId      String?
  campaign        Campaign?    @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  /// Set instead of campaignId for a Volunteer Trip payout. Plain scalar,
  /// no @relation: neither this nor any other ticket has needed .include()
  /// through it yet (routes compare it as a plain scalar, same as
  /// campaignId's own comparisons). Add the relation whenever a caller
  /// actually needs it.
  volunteerTripId String?
  bankAccountId   String
  bankAccount     BankAccount  @relation(fields: [bankAccountId], references: [id])
  amount          Int
  description     String
  /// Evidence of the transfer. Required before COMPLETED, enforced in the
  /// service layer rather than the schema because Prisma cannot express a
  /// conditional NOT NULL.
  proofImage      String?
  status          PayoutStatus @default(DRAFT)

  requestedById   String
  requestedBy     User      @relation("PayoutRequester", fields: [requestedById], references: [id])
  /// Two-person rule: the approver must not be the requester. Enforced in the
  /// service layer, and the columns exist so it is auditable after the fact.
  approvedById    String?
  approvedBy      User?     @relation("PayoutApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  /// The second person: the Admin who recorded the transfer with proof. The
  /// two-person rule's other half (CONTEXT.md, Payout; ADR 0006) is enforced
  /// in the service layer, and the column exists so it is auditable after the
  /// fact -- approvedById alone cannot show that two people were involved,
  /// only that one of them was.
  completedById   String?
  completedBy     User?     @relation("PayoutCompleter", fields: [completedById], references: [id])
  rejectionReason String?

  providerRef             String?   @unique
  /// FFI-07 story 53: the provider balance the approving Admin read in the
  /// provider's dashboard, recorded BEFORE approving, and the provider it was
  /// read from. Required of every approval from this ticket on -- Sumopod
  /// exposes no balance API, so the system cannot check this itself and a
  /// figure nobody wrote down proves nothing (ADR 0006).
  ///
  /// Both are nullable only so history stays: a Payout approved before this
  /// column existed has no reading, and saying so is the honest record. The
  /// service layer refuses an approval that supplies neither, and refuses one
  /// whose reading is short of the Payout's own amount.
  ///
  /// NOT a reconciliation datum. This is a reading of one moment, and the
  /// ledger's Provider Balance is a figure for a different moment, so the two
  /// are never subtracted from each other. The reconciliation reads the
  /// ProviderWithdrawal pair instead -- a reading taken either side of a
  /// movement that has just been posted -- where both sides describe the same
  /// instant. See src/lib/money/provider-withdrawals.ts.
  approvedProvider        String?
  approvedProviderBalance Int?
  completedAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  ledgerEntries LedgerEntry[]
  usageReport   UsageReport?
  balanceChecks PayoutBalanceCheck[]

  @@index([campaignId, status])
  @@index([volunteerTripId, status])
  @@index([status])
}

/// One Admin's record that they read the provider's dashboard and found it
/// short of a DRAFT Payout's amount (ticket 30; ticket 02's answer, second
/// half; PRD FFI-07). Append-only check history, never a Payout status of
/// its own: the Payout stays DRAFT/awaiting approval while this exists, and
/// recording one never writes the Payout row. A Payout may collect several
/// rows over time; none is ever edited or deleted, and none is removed once
/// the Payout is later approved -- resolution is derived from the Payout's
/// own status (APPROVED/COMPLETED means resolved), never from a column
/// here, so these rows stay as a trail (owner decision 2026-09-28).
model PayoutBalanceCheck {
  id              String   @id @default(cuid())
  payoutId        String
  payout          Payout   @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  checkedById     String
  checkedBy       User     @relation("PayoutBalanceCheckedBy", fields: [checkedById], references: [id])
  /// The one name the provider registry knows, same as
  /// Payout.approvedProvider -- resolved before the row is written so this
  /// column cannot collect two spellings of one provider.
  provider        String
  /// What the dashboard showed, in rupiah. Always short of the Payout's own
  /// amount at the moment it was recorded -- recordPayoutBalanceShort
  /// refuses a reading that already covers it, since the Admin should
  /// approve instead.
  recordedBalance Int
  checkedAt       DateTime @default(now())

  @@index([payoutId])
}

/// A Fundraiser's account of how one Payout's money was used (CONTEXT.md,
/// Usage Report; PRD FFI-07a). Exactly one per Payout -- payoutId is unique,
/// so a second submission for the same Payout is a schema-level conflict, not
/// just a service-layer one -- and only a COMPLETED Payout may carry one: a
/// DRAFT or APPROVED Payout's money has not necessarily moved yet, so there
/// would be nothing yet to report on (enforced in the service layer,
/// src/lib/usage-reports.ts, since Prisma cannot express a conditional
/// dependency on another row's status).
///
/// Public the moment it is submitted -- "tampil publik ... sejak dikirim,
/// tanpa menunggu tinjauan" -- so nothing here is a draft state; the only
/// state a report moves through afterwards is Admin marking it disputed.
model UsageReport {
  id       String @id @default(cuid())
  payoutId String @unique
  payout   Payout @relation(fields: [payoutId], references: [id])

  /// Free narrative of how the money was used.
  narrative String @db.Text

  /// Per-post breakdown, `[{ label: string, amount: number }]`. Not
  /// relational rows: nothing sums or filters by a single line item anywhere
  /// else in the app, and a Json column keeps a report's shape wholly owned
  /// by this one row rather than spread across a child table. The service
  /// layer requires each amount to be a positive whole rupiah and the total
  /// to equal the Payout's own `amount` exactly -- "rincian per pos yang
  /// jumlahnya sama dengan nominal Payout" -- so this is validated data, not
  /// merely stored data, even though Prisma cannot express that constraint
  /// itself.
  lineItems Json

  /// "Jumlah penerima manfaat" (PRD FFI-07a): how many people this Payout's
  /// spending reached, the same figure the Impact & Transparency page sums
  /// across every Usage Report once that page is built (PRD FFI-14).
  beneficiaryCount Int

  /// "Minimal satu foto bukti": at least one URL, enforced in the service
  /// layer the same way CampaignUpdate.images is (never in the schema, which
  /// cannot express a minimum array length).
  photos String[]

  submittedById String
  submittedBy   User     @relation("UsageReportSubmitter", fields: [submittedById], references: [id])
  createdAt     DateTime @default(now())

  /// Admin's "dipertanyakan" marker (PRD FFI-07a): set together, tampil
  /// publik beside the report itself, and -- per the same story -- blocks
  /// the Payout after this Usage Report's own Payout from being requested,
  /// the same as a Usage Report that was never submitted at all (see
  /// requestPayout, src/lib/money/payouts.ts). Nullable together because a
  /// report is undisputed until an Admin acts; there is no code path that
  /// clears a dispute once set, since nothing in the spec describes lifting
  /// one.
  disputedAt     DateTime?
  disputedReason String?
  disputedById   String?
  disputedBy     User?     @relation("UsageReportDisputer", fields: [disputedById], references: [id])
}

/// One withdrawal of money from a Payment Provider's Merchant Account to a
/// Collection Account (CONTEXT.md, Merchant Account; ADR 0011; PRD FFI-07).
///
/// The third and last movement that credits the Provider Balance, and the only
/// one that takes money to a bank rather than to a Donor or a Fundraiser. It
/// exists so the gap between "the money is at the provider" and "the money is
/// in the bank" is a row somebody wrote rather than an assumption.
model ProviderWithdrawal {
  id                    String   @id @default(cuid())
  /// Which Payment Provider the money was drawn from. The same plain String
  /// Payment.provider holds, and stamped on the ledger entry this row posts
  /// (LedgerEntry.provider) so the Provider Balance can be read per provider.
  provider              String
  /// The provider's own reference for this disbursement, from its dashboard.
  ///
  /// UNIQUE, and that is the whole idempotency story for this table: recording
  /// a withdrawal twice would take the money out of the pot twice, and the
  /// provider issues one reference per disbursement, so the same reference
  /// arriving twice is the same money being claimed twice. The service claims
  /// on this index before it posts anything, which is the same shape as the
  /// ledger's own claim on a transactionId (prd-compliance 28b) and is checked
  /// for the same reason: a read-then-write would be no constraint at all.
  reference             String   @unique
  /// Whole rupiah taken out of the Provider Balance. Always positive; the
  /// direction is what carries the sign (src/lib/money/ledger.ts).
  amount                Int
  /// The account holder as the provider has it registered -- the entity whose
  /// bank account received the money. Free text rather than a foreign key
  /// because the collection account is a BANK account of a legal entity, and
  /// this repo's BankAccount model is a Fundraiser's destination account, not
  /// this.
  destinationName       String
  /// Set when that holder is a registered Collecting Entity, which is the case
  /// that matters for ADR 0011: the Merchant Account is PT Jaya Korpora
  /// Prima's, and the collection account is allowed to belong to somebody else
  /// entirely. Left null when it is not -- a withdrawal to the platform's own
  /// bank, say, which is a real possibility and deliberately not modelled as a
  /// Partner Organisation.
  collectingEntityId    String?
  /// What the Admin read in the provider's dashboard immediately before and
  /// immediately after the withdrawal. BOTH required, never optional: an
  /// unread pot is the exact condition this ticket exists to stop being
  /// invisible, and "the Admin did not look" is not a number.
  ///
  /// The two are NOT required to differ by `amount`. They legitimately do when
  /// the provider moved money on its own across the same window -- a fee it
  /// charged on the transfer, a chargeback that landed -- and forcing them to
  /// agree would refuse an honest record of exactly the event this report
  /// exists to surface. The gap is reported instead, per withdrawal and in
  /// total, and nobody corrects it.
  providerBalanceBefore Int
  providerBalanceAfter  Int
  /// Where the evidence lives. Required, like a Payout's proofImage and for the
  /// same reason: an unevidenced movement of the platform's own money is not a
  /// record.
  proofReference        String
  recordedById          String
  recordedAt            DateTime @default(now())

  collectingEntity PartnerOrganisation? @relation(fields: [collectingEntityId], references: [id], onDelete: Restrict)
  recordedBy       User                 @relation("ProviderWithdrawalRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  ledgerEntries    LedgerEntry[]

  // The per-provider reconciliation reads every recorded sweep in recordedAt
  // order, so this is the index that query wants.
  @@index([provider, recordedAt])
}

/// Double-entry ledger. Append-only: rows are never updated or deleted, and a
/// correction is a new pair of entries, not an edit.
///
/// Every movement writes at least two rows summing to zero across DEBIT and
/// CREDIT. A campaign's withdrawable balance is
///   sum(CREDIT) - sum(DEBIT) on CAMPAIGN_BALANCE for that campaign,
/// computed on read. Campaign.collectedAmount remains as a display figure and
/// is no longer authoritative.
model LedgerEntry {
  id        String          @id @default(cuid())
  account   LedgerAccount
  direction LedgerDirection
  amount    Int

  /// Which campaign this entry belongs to, where the account is
  /// campaign-scoped. Null for platform-level accounts.
  campaignId      String?
  campaign        Campaign? @relation(fields: [campaignId], references: [id])
  /// Trip-scoped sibling of campaignId, same optionality shape. Plain
  /// scalar, no @relation: VolunteerTrip doesn't exist yet -- Ticket 02
  /// adds the relation once it does.
  volunteerTripId String?
  /// Program-scoped sibling of volunteerTripId, and deliberately a plain
  /// scalar with no @relation like it. The one @relation that would have
  /// carried a Program id into a money model is the one Program must not
  /// have: a back-relation would put a ledger name on the Program row and
  /// blur the line csr-01 drew (program-money-isolation.test.ts pins it).
  /// The referential guarantee comes from ManualContribution.programId, a
  /// real foreign key, written in the same transaction as the entries below
  /// -- and the only writer of a programId here is that module.
  programId       String?

  /// Exactly one of these is set, naming what caused the movement.
  paymentId            String?
  payment              Payment?            @relation(fields: [paymentId], references: [id])
  refundId             String?
  refund               Refund?             @relation(fields: [refundId], references: [id])
  payoutId             String?
  payout               Payout?             @relation(fields: [payoutId], references: [id])
  /// Which Manual Contribution this movement belongs to -- set on both the
  /// credit and its reversal, which is what lets a reader tell money that
  /// arrived off-gateway apart from money that came through a Payment.
  manualContributionId String?
  manualContribution   ManualContribution? @relation(fields: [manualContributionId], references: [id])
  /// Which ProviderWithdrawal this movement belongs to (prd-compliance 35).
  /// The attribution the per-withdrawal reconciliation needs: the GATEWAY_CLEARING
  /// credit and the COLLECTION_ACCOUNT debit are the two legs of one recorded
  /// sweep, and a report that cannot say which recorded sweep a given pot
  /// movement was would have to reconcile a total against a set of readings and
  /// guess which reading belonged to which movement.
  providerWithdrawalId String?
  providerWithdrawal   ProviderWithdrawal? @relation(fields: [providerWithdrawalId], references: [id])

  /// Which Payment Provider this movement went through or was paid out of
  /// (CONTEXT.md, Provider Balance, "Tercatat sebagai akun buku besar
  /// tersendiri per penyedia"). Nullable, and a null is a real answer rather
  /// than missing data: it means nobody recorded which provider this movement
  /// belongs to, and a report that folds those rows into a named provider would
  /// be reporting the wrong number for the wrong reason.
  ///
  /// Written on exactly two kinds of movement today, the two where the provider
  /// is a fact at the moment the movement is posted: a Settlement (the
  /// Payment's own provider) and a withdrawal to the Collection Account (the
  /// ProviderWithdrawal's provider). Deliberately NOT written on the other two
  /// movements that credit the Provider Balance -- a completed Payout and a
  /// paid Refund, neither of which anyone records a provider for -- which is
  /// why the per-provider pot is a floor rather than the whole thing. See
  /// GATEWAY_CLEARING above and providerBalances in src/lib/money/ledger.ts.
  ///
  /// A plain String, like Payment.provider, and for Payment.provider's reason:
  /// the registered names live in src/lib/payments/provider-names.ts, so the
  /// schema stores the value without keeping a second list of it. This column
  /// is read back by exact string equality and never canonicalized, so a name
  /// an older row still carries keeps its own pot in providerBalances.
  provider String?

  /// Groups the entries of one balanced transaction. Every entry sharing a
  /// transactionId must sum to zero; that invariant is asserted in tests and
  /// by a periodic check, since Prisma cannot express it as a constraint.
  ///
  /// A transactionId is also CLAIMED by exactly one entry, the one with
  /// `legIndex` 0, and the database refuses a second claim -- see legIndex.
  transactionId String
  /// Position of this entry inside its transaction, counting from 0.
  ///
  /// Leg 0 claims the transactionId, and the partial unique index
  /// `LedgerEntry_transactionId_claim_key` (WHERE "legIndex" = 0) is what makes
  /// that claim unrepeatable. Re-posting a transactionId is therefore refused
  /// by the constraint itself rather than by a read that two concurrent
  /// writers can both pass. The index is created in the migration, not here:
  /// a partial index is something this schema language cannot express, the
  /// same arrangement as Payment_donationId_paid_key.
  legIndex      Int
  memo          String?
  createdAt     DateTime @default(now())

  @@index([transactionId])
  @@index([account, campaignId])
  @@index([account, volunteerTripId])
  @@index([account, programId])
  // The Provider Balance is read grouped by provider and direction, so this
  // is the index that query wants rather than one on provider alone.
  @@index([account, provider])
  @@index([campaignId, createdAt])
  @@index([manualContributionId])
  @@index([providerWithdrawalId])
}

/// The old `Disbursement` table, renamed rather than dropped by the money-layer
/// migration. Twelve real rows claiming money left the platform, with no status,
/// no approver and no destination account -- they cannot be turned into Payouts
/// without inventing the facts that make a Payout checkable.
///
/// Declared here for one reason: a table the schema does not know about is a
/// table the next `prisma migrate dev` writes a DROP TABLE for. Mapping it keeps
/// Prisma's drift detection from quietly proposing to delete the only copy.
///
/// Read-only. Nothing writes to this model. It should end as either a mapped set
/// of Payout rows or an export plus a drop -- a decision for whoever can say what
/// these twelve payouts actually were.
model DisbursementLegacy {
  /// The pk and index keep their pre-rename names. Mapping them is one line;
  /// renaming them is DDL against a live table for no gain but tidiness.
  id          String   @id(map: "Disbursement_pkey")
  amount      Int
  description String
  proofImage  String?
  campaignId  String
  createdAt   DateTime @default(now())

  @@index([campaignId], map: "Disbursement_campaignId_idx")
  @@map("Disbursement_legacy")
}

// ==================== Volunteer Trip ====================

enum VolunteerTripStatus {
  DRAFT
  SUBMITTED
  REJECTED
  ACTIVE
  SUSPENDED
  CANCELLED
  COMPLETED
}

/// A Fundraiser-owned catalog item: destination, itinerary, and a Trip Fee
/// shared across every Batch of this Trip. Deliberately not a Campaign and
/// not a Kind -- see ADR 0014. Shaped like Campaign minus targetAmount/
/// deadline/isUrgent/isDemo, plus destination/itinerary/tripFeeAmount.
model VolunteerTrip {
  id            String              @id @default(cuid())
  slug          String              @unique
  title         String
  description   String              @db.Text
  story         String              @db.Text
  coverImage    String
  destination   String
  itinerary     String              @db.Text
  tripFeeAmount Int
  status        VolunteerTripStatus @default(DRAFT)
  fundraiserId  String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  // Relations
  fundraiser    User                        @relation(fields: [fundraiserId], references: [id], onDelete: Cascade)
  batches       VolunteerBatch[]
  statusChanges VolunteerTripStatusChange[]

  @@index([slug])
  @@index([status])
  @@index([fundraiserId])
}

/// What a Volunteer Trip status change was: the Fundraiser submitting it for
/// review, a Verifier approving or rejecting that submission, or an Admin
/// suspending the Trip and lifting that Suspension (ticket 38).
enum VolunteerTripStatusChangeAction {
  SUBMITTED
  SUBMISSION_APPROVED
  SUBMISSION_REJECTED
  SUSPENDED
  SUSPENSION_LIFTED
}

/// Append-only record of every Volunteer Trip status change, shaped like
/// CampaignStatusChange but kept apart from it (ADR 0014). Written only by
/// src/lib/volunteer/trip.ts, in the same transaction as the change itself;
/// never updated or deleted. Batch and Registration changes are not logged
/// here: their money trail is the ledger and Refunds.
///
/// onDelete: Restrict on both relations, as on CampaignStatusChange: deleting
/// a Trip or a person must never erase who changed what.
model VolunteerTripStatusChange {
  id         String                          @id @default(cuid())
  tripId     String
  action     VolunteerTripStatusChangeAction
  fromStatus VolunteerTripStatus
  toStatus   VolunteerTripStatus
  /// Null exactly when capacity is SYSTEM.
  actorId    String?
  capacity   StatusChangeCapacity
  reason     String?
  createdAt  DateTime                        @default(now())

  // Relations
  trip  VolunteerTrip @relation(fields: [tripId], references: [id], onDelete: Restrict)
  actor User?         @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([tripId, createdAt])
}

enum VolunteerBatchStatus {
  OPEN
  CLOSED
  CANCELLED
  COMPLETED
}

/// One dated instance of a Volunteer Trip. maxQuota/minQuota are Fundraiser-
/// set per Batch, never a platform-wide constant (ADR 0014). This ticket
/// only ever produces OPEN; the rest of the enum exists so a later ticket
/// (Registration, Batch cancellation) needs no schema change to use it.
model VolunteerBatch {
  id                   String               @id @default(cuid())
  tripId               String
  startDate            DateTime
  endDate              DateTime
  registrationDeadline DateTime
  maxQuota             Int
  minQuota             Int
  status               VolunteerBatchStatus @default(OPEN)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  // Relations
  trip          VolunteerTrip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  registrations Registration[]

  @@index([tripId])
  @@index([status])
}

enum RegistrationStatus {
  HOLD
  CONFIRMED
  EXPIRED
  CANCELLED
}

/// A Volunteer's registration on one Volunteer Batch. HOLD and CONFIRMED
/// together count toward the Batch's maxQuota; only CONFIRMED counts toward
/// minQuota. status is denormalized from this Registration's Payment.status,
/// kept in sync by the settlement webhook (Task 3) and the
/// hold-expiry sweep (Task 2), never by this Registration being written
/// directly outside those two paths.
model Registration {
  id            String             @id @default(cuid())
  volunteerId   String
  batchId       String
  status        RegistrationStatus @default(HOLD)
  holdExpiresAt DateTime
  /// Whether the Fundraiser marked this Volunteer present when completing the
  /// Batch (ticket 35). Written once, by completeBatch, and false for every
  /// Registration until then; only an attended CONFIRMED Registration earns a
  /// Sertifikat Keikutsertaan.
  attended      Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  // Relations
  volunteer User           @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  batch     VolunteerBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  payment   Payment?

  @@index([volunteerId])
  @@index([batchId])
  @@index([status])
  @@index([holdExpiresAt])
}
