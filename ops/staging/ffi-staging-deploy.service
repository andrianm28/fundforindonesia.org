# Deploys the newest staging release (docs/runbooks/staging.md). Started by
# ffi-staging-deploy.timer; the script exits at once when nothing moved.
# Install: copy both units to /etc/systemd/system/, set WorkingDirectory and
# ExecStart to the staging deploy directory, then
#   systemctl daemon-reload && systemctl enable --now ffi-staging-deploy.timer
[Unit]
Description=Fund for Indonesia staging: deploy the newest :staging image
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
# The staging deploy directory, never production's.
WorkingDirectory=/home/deploy/fundforindonesia-stg
ExecStart=/home/deploy/fundforindonesia-stg/ops/deploy-staging.sh
TimeoutStartSec=15min
Nice=10
