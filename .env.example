# Database
DB_PASSWORD=changeme123

# NextAuth
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=https://your-domain.com

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payment provider
#
# The key webhook signatures are verified against. NOT optional: the provider
# refuses to construct without it, and the webhook route answers 503 rather
# than accepting events it cannot check. An empty value would verify every
# signature against a secret anyone can guess.
#
# Replace with the real Midtrans server key when a merchant account exists.
MOCK_MIDTRANS_SERVER_KEY=generate-with-openssl-rand-hex-32
