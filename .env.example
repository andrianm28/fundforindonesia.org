# Database
DB_PASSWORD=changeme123

# NextAuth
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=https://your-domain.com

# The canonical public site address that every absolute link starts with: SEO
# metadata, the sitemap, the Campaign page and email links
# (src/lib/public-url.ts). Unset, it is https://fundforindonesia.org. Never
# NEXTAUTH_URL, which is where next-auth runs, not the public address.
#
# NEXT_PUBLIC_, so it is baked into the bundles at build time: in Docker it is
# a build arg (Dockerfile, cd.yml's repository variable of the same name), and
# a value in the runtime environment is ignored.
NEXT_PUBLIC_BASE_URL=https://fundforindonesia.org

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payment provider
#
# The key webhook signatures are verified against. NOT optional: the provider
# refuses to construct without it, and the webhook route answers 503 rather
# than accepting events it cannot check. An empty value would verify every
# signature against a secret anyone can guess.
#
# Replace with the real Midtrans server key when a merchant account exists.
MOCK_MIDTRANS_SERVER_KEY=generate-with-openssl-rand-hex-32

# Which provider takes new charges and payouts. One of: mock, sumopod.
# Defaults to mock when unset. The webhook route ignores this and uses the
# provider named in its own URL instead, so a payment made before a switch
# still settles afterwards.
PAYMENT_PROVIDER=mock

# Whether the donate button actually takes money. Off unless set to exactly
# the string "true" -- "1", "yes" and "TRUE" all count as off, because
# guessing in the permissive direction turns a typo into live collection.
#
# NEXT_PUBLIC_ because the donate page reads it too, to show the disabled
# message before a donor fills in an amount. That also means it is baked into
# the client bundle at build time: a Docker deployment changes it by
# rebuilding, not by restarting.
#
# Turn it on in development against the Sumopod sandbox. In production the
# API refuses every donation anyway while PAYMENT_PROVIDER is the mock, or
# while SUMOPOD_BASE_URL is a sandbox url -- see sandboxInProductionReason
# in src/lib/donations.ts.
NEXT_PUBLIC_DONATIONS_ENABLED=false

# Opens the Volunteer Trip Registration flow (Daftar button, summary page,
# POST .../registrations). Off by default; the owner turns it on only after the
# payment provider adapter and a sandbox Trip Fee test are done. Exact "true"
# only. Inlined at build time like the switch above.
NEXT_PUBLIC_VOLUNTEER_ENABLED=false

# Sumopod. Required only when PAYMENT_PROVIDER=sumopod, or when Sumopod
# webhooks are pointed at /api/webhooks/sumopod.
#
# SUMOPOD_WEBHOOK_SECRET is the whsec_ value from the dashboard's Settings
# tab. NOT optional: an empty value would verify every signature against
# nothing, which accepts forged settlements while looking healthy.
#
# Sandbox base url is https://api-pay-sandbox.sumopod.com/api/v1. Ask Sumopod
# for the production one; it is not documented.
SUMOPOD_API_KEY=
SUMOPOD_WEBHOOK_SECRET=
SUMOPOD_BASE_URL=https://api-pay-sandbox.sumopod.com/api/v1

# Mailer
#
# Which Mailer sends email. One of: mock, smtp. Unset, it is mock in
# development and tests and smtp in production. The mock keeps messages in
# memory and delivers nothing, so production refuses it. In production a
# missing SMTP_* value or MAIL_FROM is logged loudly as mail_not_configured
# on every email the platform tries to send; a Verifier's decision still
# goes through and the Fundraiser still gets the in-app notification.
MAIL_PROVIDER=

# SMTP relay. Production uses the Sumopod relay (smtp.sumopod.com, port 465,
# smtps); the credentials live only in the production .env.
# SMTP_SECURE is exactly "true" or "false"; unset means true on port 465
# (TLS from the start) and false elsewhere (STARTTLS).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@your-domain.com

# Where Partnership Inquiry notifications go (CONTEXT.md, Partnership Inquiry).
# The partnership team's own mailbox, and configuration with no default: the
# real address is the owner's to supply. Unset in production, a submitted
# Inquiry is still recorded and the miss is logged as mail_not_configured;
# unset in development it is simply not sent, since the mock Mailer delivers
# nowhere anyway.
PARTNERSHIP_TEAM_EMAIL=

# The secret that lets a scheduler run the platform's scheduled jobs.
#
# `POST /api/internal/jobs/run` runs the matured-escrow release and the two
# reminder sweeps, so it is a money-moving, email-sending endpoint on a public
# URL. It compares the `x-jobs-secret` header against this value in constant
# time and refuses everything else. With this unset it refuses everything too:
# never a request that reaches the jobs unauthenticated.
#
#   openssl rand -base64 32
#
# Production sets it in the host's .env only. Never in this file, never in
# git. A scheduler needs the same value, so a host cron line reads it from
# that .env; a GitHub Actions schedule would instead need it as an Actions
# secret, which only the owner can create.
JOBS_SECRET=

# Field-level encryption of Donor and Fundraiser contact details (ADR 0012).
#
# Two separate secrets, each a 32-byte key in base64, plus a short id for each
# that is stored beside every value it protects so keys can be rotated later:
#
#   FIELD_ENCRYPTION_KEY  AES-256-GCM key for the email, phone and bank account
#                         number ciphertexts. Losing it loses those values.
#   FIELD_HMAC_KEY        HMAC-SHA256 key for the searchable email lookup.
#                         Losing it loses matching by email, not the data.
#
# Generate each key separately (never reuse one for both; the app refuses):
#
#   openssl rand -base64 32
#
# Pick any id that names the key, e.g. enc-2026-09 and hmac-2026-09, and never
# reuse an id for a different key.
#
# Set all four. There is no working configuration without them: the plaintext
# email, phone and bank account number columns have been dropped
# (prisma/migrations/20260930010000_drop_contact_plaintext), so with no keys
# the app cannot write a contact detail at all and refuses the first one rather
# than storing something it cannot read back. Some but not all, or a key that is
# not 32 bytes, is refused the same way. Keep the keys out of the database
# host's backups; they defend against a stolen dump only if the dump does not
# come with them.
#
# A database written before the keys existed has to be backfilled before that
# migration can be applied. The migration refuses to run until it is, and says
# so:
#
#   npx tsx prisma/backfill-contact-fields.ts
#
# Safe to run more than once, and safe to stop and re-run. It must run BEFORE
# the deploy that drops the columns, not during it.
FIELD_ENCRYPTION_KEY=
FIELD_ENCRYPTION_KEY_ID=
FIELD_HMAC_KEY=
FIELD_HMAC_KEY_ID=

# Rate limit on public endpoints (ticket csr-06b). RATE_LIMIT_SECRET keys the
# hash of the caller's address (generate with: openssl rand -base64 32); empty
# falls back to NEXTAUTH_SECRET. TRUSTED_PROXY_HOPS is how many reverse proxies
# append to X-Forwarded-For before the app sees it: 1 for nginx alone. Too low
# lets a client forge its address; too high shares one bucket among everyone.
RATE_LIMIT_SECRET=
TRUSTED_PROXY_HOPS=1
