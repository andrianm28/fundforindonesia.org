# Database
DB_PASSWORD=changeme123

# NextAuth
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=https://your-domain.com

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payment provider
#
# The key webhook signatures are verified against. NOT optional: the provider
# refuses to construct without it, and the webhook route answers 503 rather
# than accepting events it cannot check. An empty value would verify every
# signature against a secret anyone can guess.
#
# Replace with the real Midtrans server key when a merchant account exists.
MOCK_MIDTRANS_SERVER_KEY=generate-with-openssl-rand-hex-32

# Which provider takes new charges and payouts. One of: mock, sumopod.
# Defaults to mock when unset. The webhook route ignores this and uses the
# provider named in its own URL instead, so a payment made before a switch
# still settles afterwards.
PAYMENT_PROVIDER=mock

# Whether the donate button actually takes money. Off unless set to exactly
# the string "true" -- "1", "yes" and "TRUE" all count as off, because
# guessing in the permissive direction turns a typo into live collection.
#
# NEXT_PUBLIC_ because the donate page reads it too, to show the disabled
# message before a donor fills in an amount. That also means it is baked into
# the client bundle at build time: a Docker deployment changes it by
# rebuilding, not by restarting.
#
# Turn it on in development against the Sumopod sandbox. In production the
# API refuses every donation anyway while PAYMENT_PROVIDER is the mock, or
# while SUMOPOD_BASE_URL is a sandbox url -- see sandboxInProductionReason
# in src/lib/donations.ts.
NEXT_PUBLIC_DONATIONS_ENABLED=false

# Sumopod. Required only when PAYMENT_PROVIDER=sumopod, or when Sumopod
# webhooks are pointed at /api/webhooks/sumopod.
#
# SUMOPOD_WEBHOOK_SECRET is the whsec_ value from the dashboard's Settings
# tab. NOT optional: an empty value would verify every signature against
# nothing, which accepts forged settlements while looking healthy.
#
# Sandbox base url is https://api-pay-sandbox.sumopod.com/api/v1. Ask Sumopod
# for the production one; it is not documented.
SUMOPOD_API_KEY=
SUMOPOD_WEBHOOK_SECRET=
SUMOPOD_BASE_URL=https://api-pay-sandbox.sumopod.com/api/v1

# Mailer
#
# Which Mailer sends email. One of: mock, smtp. Unset, it is mock in
# development and tests and smtp in production. The mock keeps messages in
# memory and delivers nothing, so production refuses it. In production a
# missing SMTP_* value or MAIL_FROM is a loud failure: a Verifier's decision
# is refused rather than taken without telling the Fundraiser.
MAIL_PROVIDER=

# SMTP relay. Production uses the Sumopod relay (smtp.sumopod.com, port 465,
# smtps); the credentials live only in the production .env.
# SMTP_SECURE is exactly "true" or "false"; unset means true on port 465
# (TLS from the start) and false elsewhere (STARTTLS).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@your-domain.com
